# App Environment
APP_ENV=production
APP_NAME="Best Diversified Company Award"
APP_URL=http://localhost:4321

# Admin Notification Recipient(s) — comma-separated
ADMIN_EMAIL=admin@yourdomain.com

# Sender Identity
MAIL_FROM_ADDRESS=notifications@yourdomain.com
MAIL_FROM_NAME="Diversified Company Awards"

# Universal SMTP — supports SSL (465), STARTTLS (587), Gmail, cPanel, Office 365, Zoho
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your_strong_password
SMTP_AUTH=true
SMTP_ALLOW_SELF_SIGNED=false

# Secrets
DOWNLOAD_SECRET=change_this_to_64_char_secure_random_hex_value_now
ADMIN_SESSION_SECRET=change_this_to_64_char_secure_random_hex_value_now
SESSION_LIFETIME=86400

# Database Connection (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/award_db"

# Admin Registration Security Secret
ADMIN_REGISTRATION_SECRET="choose_a_strong_secret_key_here_2026"
