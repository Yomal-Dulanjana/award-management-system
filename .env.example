# App Environment
APP_ENV=production
APP_DEBUG=false
APP_NAME="Best Diversified Company Award 2025/26"
APP_URL=https://yourdomain.com

# Database Connection (MySQL / TiDB Cloud)
DATABASE_URL=

# Sender Identity
MAIL_FROM="Best Diversified Company Award 2025/26 <noreply@yourdomain.com>"
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Best Diversified Company Award 2025/26"

# SMTP Relay Settings (e.g. Brevo SMTP Relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Application Secrets & Session Management
ADMIN_SESSION_SECRET=
DOWNLOAD_SECRET=
ADMIN_REGISTRATION_SECRET=
SESSION_LIFETIME=86400

# Optional CLI Initial Seeding Credentials
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=
