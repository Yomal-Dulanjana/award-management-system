---
import Layout from '@/layouts/Layout.astro';
import SignaturePad from '@/components/signature/SignaturePad.astro';
---

<Layout title="Apply - Best Diversified Company Award 2025/26">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
    <!-- Back link -->
    <a
      href="/"
      class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-amber-400 mb-6 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Back to Award Overview</span>
    </a>

    <!-- Top Card: Header & Progress Bar -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl backdrop-blur-xl mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div>
          <span class="text-xs uppercase font-bold text-amber-400 tracking-wider">Application Dossier</span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Official Submission Form</h1>
        </div>
        <div class="text-right">
          <span id="step-counter" class="text-xs font-mono font-bold text-amber-400 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/20">
            Step 1 of 6
          </span>
        </div>
      </div>

      <!-- Animated Progress Bar -->
      <div class="mt-6">
        <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden">
          <div
            id="step-progress-bar"
            class="h-full bg-gradient-to-r from-amber-500 to-amber-400 transition-all duration-300 ease-out"
            style="width: 16.66%"
          ></div>
        </div>
        <div class="flex justify-between text-[11px] font-medium text-slate-400 mt-2.5 hidden sm:flex">
          <span class="step-lbl" data-step="1">1. Company</span>
          <span class="step-lbl" data-step="2">2. Qualification</span>
          <span class="step-lbl" data-step="3">3. Revenue</span>
          <span class="step-lbl" data-step="4">4. Margin</span>
          <span class="step-lbl" data-step="5">5. ROI</span>
          <span class="step-lbl" data-step="6">6. Declaration</span>
        </div>
      </div>
    </div>

    <!-- Error Alert Banner -->
    <div
      id="error-banner"
      class="hidden bg-rose-950/60 border border-rose-800 text-rose-200 px-5 py-4 rounded-2xl mb-8 flex items-start gap-3 text-sm animate-shake"
      role="alert"
    >
      <svg class="w-5 h-5 text-rose-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <div id="error-message" class="flex-1 font-medium">Please correct the highlighted fields.</div>
    </div>

    <!-- Draft notification -->
    <div
      id="draft-banner"
      class="hidden bg-blue-950/60 border border-blue-800 text-blue-200 px-5 py-3 rounded-2xl mb-6 flex items-center justify-between text-xs"
    >
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        Restored saved draft from local storage.
      </span>
      <button type="button" id="clear-draft-btn" class="text-rose-400 hover:text-rose-300 font-semibold underline">
        Discard Draft
      </button>
    </div>

    <!-- Main Wizard Form Container -->
    <form id="award-form" class="space-y-8" novalidate>
      <!-- Honeypot anti-spam field -->
      <input
        type="text"
        name="website_url"
        value=""
        autocomplete="off"
        tabindex="-1"
        aria-hidden="true"
        style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none"
      />

      <!-- STEP 1: Company Details & Contact -->
      <section class="wizard-step bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6" data-step="1">
        <div>
          <h2 class="text-xl font-bold text-white">1. Company Details & Contact Information</h2>
          <p class="text-slate-400 text-xs mt-1">Specify applicant identity, nature of enterprise, and designated officer.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Company Name <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              name="company_name"
              required
              placeholder="e.g. Acme Industrial Group PLC"
              class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Financial Year Covered
            </label>
            <input
              type="text"
              name="financial_year"
              value="2025/26"
              readonly
              class="w-full bg-slate-800/40 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-400 cursor-not-allowed select-none"
            />
          </div>

          <div class="sm:col-span-2 space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Nature of Operations <span class="text-rose-400">*</span>
            </label>
            <select
              name="nature_operations"
              required
              class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
            >
              <option value="">Select category...</option>
              <option value="Manufacturing">Manufacturing</option>
              <option value="Services">Services</option>
              <option value="Trading">Trading</option>
              <option value="Mixed">Mixed</option>
            </select>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-800">
          <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4">Designated Contact Person</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="sm:col-span-2 space-y-1.5">
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
                Name & Designation <span class="text-rose-400">*</span>
              </label>
              <input
                type="text"
                name="contact_name_designation"
                required
                placeholder="e.g. A. B. Perera - Managing Director"
                class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
              />
            </div>

            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
                Email Address <span class="text-rose-400">*</span>
              </label>
              <input
                type="email"
                name="contact_email"
                required
                placeholder="e.g. perera@acme.com"
                class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
              />
            </div>

            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
                Telephone <span class="text-rose-400">*</span>
              </label>
              <input
                type="tel"
                name="contact_phone"
                required
                placeholder="e.g. +94 11 234 5678"
                class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
              />
            </div>
          </div>
        </div>

        <div class="flex justify-end pt-4">
          <button
            type="button"
            class="next-step-btn px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm flex items-center gap-2 shadow-lg shadow-amber-500/20 transition-all"
          >
            <span>Continue to Step 2</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </section>

      <!-- STEP 2: Qualification & Diversified Products -->
      <section class="wizard-step hidden bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6" data-step="2">
        <div>
          <h2 class="text-xl font-bold text-white">2. Diversification Qualification & Activities</h2>
          <p class="text-slate-400 text-xs mt-1">Both qualification conditions are mandatory under award statute.</p>
        </div>

        <!-- Mandatory Choices Box -->
        <div class="bg-blue-950/40 border border-blue-900/60 rounded-2xl p-5 space-y-4">
          <div class="flex items-center gap-2 text-xs font-bold text-amber-400 uppercase tracking-wider">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Mandatory Core Criteria</span>
          </div>

          <div class="space-y-3">
            <label class="flex items-start gap-3 cursor-pointer p-3 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-colors">
              <input
                type="checkbox"
                name="new_products_services"
                value="true"
                class="mt-1 w-4 h-4 rounded text-amber-500 bg-slate-800 border-slate-700 focus:ring-amber-400 focus:ring-offset-0"
                required
              />
              <span class="text-sm">
                <strong class="text-white block">New Products / Services Introduced</strong>
                <span class="text-slate-400 text-xs">The product or service did not exist in the company prior to this initiative.</span>
              </span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer p-3 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-colors">
              <input
                type="checkbox"
                name="new_market_entered"
                value="true"
                class="mt-1 w-4 h-4 rounded text-amber-500 bg-slate-800 border-slate-700 focus:ring-amber-400 focus:ring-offset-0"
                required
              />
              <span class="text-sm">
                <strong class="text-white block">New Market Entered</strong>
                <span class="text-slate-400 text-xs">A customer segment, industry, or geographic market not previously served.</span>
              </span>
            </label>
          </div>
        </div>

        <!-- Products Repeater -->
        <div class="space-y-4 pt-2">
          <div class="flex items-center justify-between">
            <label class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Diversified Products / Services Introduced <span class="text-rose-400">*</span>
            </label>
            <span class="text-[11px] text-slate-400">Add at least one item</span>
          </div>

          <div id="products-list" class="space-y-3">
            <!-- Row 1 Default -->
            <div class="product-row bg-slate-800/40 border border-slate-800 rounded-2xl p-4 flex flex-col sm:flex-row gap-3 items-start sm:items-center">
              <span class="w-6 h-6 rounded-full bg-slate-800 text-amber-400 font-mono text-xs font-bold flex items-center justify-center shrink-0">
                1
              </span>
              <input
                type="text"
                name="products[0][name]"
                required
                placeholder="Product / Service Name"
                class="w-full sm:w-1/3 bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400"
              />
              <input
                type="text"
                name="products[0][description]"
                required
                placeholder="Brief description of product, features, and target segment"
                class="w-full sm:flex-1 bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400"
              />
              <button
                type="button"
                class="remove-row-btn text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 p-2 rounded-lg text-xs transition-colors shrink-0 hidden"
                title="Remove Item"
              >
                ✕
              </button>
            </div>
          </div>

          <button
            type="button"
            id="add-product-btn"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-700 bg-slate-800/50 hover:bg-slate-800 text-xs font-semibold text-slate-300 hover:text-white transition-colors"
          >
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Add another product / service</span>
          </button>
        </div>

        <!-- New Market Details -->
        <div class="space-y-1.5 pt-2">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Details of New Market Entered <span class="text-rose-400">*</span>
          </label>
          <textarea
            name="new_market_details"
            required
            rows="3"
            placeholder="Describe the customer segment, industry, or geographic territory not previously served..."
            class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
          ></textarea>
        </div>

        <!-- Evidence files upload -->
        <div class="space-y-1.5 pt-2">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Supporting Evidence & Documents (Optional)
          </label>
          <div class="text-[11px] text-slate-400 mb-2">
            Attach brief reports, product brochures, or images demonstrating diversification (PDF/JPG/PNG/WEBP, max 5MB each).
          </div>
          <input
            type="file"
            name="evidence_files[]"
            multiple
            accept=".pdf,.jpg,.jpeg,.png,.webp"
            class="block w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-slate-200 hover:file:bg-slate-700 cursor-pointer"
          />
        </div>

        <div class="flex justify-between pt-6 border-t border-slate-800">
          <button
            type="button"
            class="prev-step-btn px-6 py-3 rounded-xl border border-slate-700 bg-slate-800/60 hover:bg-slate-800 text-slate-300 font-semibold text-sm transition-colors"
          >
            Back
          </button>
          <button
            type="button"
            class="next-step-btn px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm flex items-center gap-2 shadow-lg shadow-amber-500/20 transition-all"
          >
            <span>Continue to Step 3</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </section>

      <!-- STEP 3: Revenue from Diversification -->
      <section class="wizard-step hidden bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6" data-step="3">
        <div>
          <h2 class="text-xl font-bold text-white">3. Revenue from Diversification</h2>
          <p class="text-slate-400 text-xs mt-1">All figures must be based on Audited Financial Statements.</p>
        </div>

        <div class="space-y-1.5 max-w-md">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Total Audited Company Revenue (Rs.) <span class="text-rose-400">*</span>
          </label>
          <input
            type="text"
            inputmode="decimal"
            name="total_company_revenue"
            id="total_company_revenue"
            required
            placeholder="e.g. 100,000,000"
            class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
          />
        </div>

        <!-- Revenue Repeater -->
        <div class="space-y-4 pt-4 border-t border-slate-800">
          <div class="flex items-center justify-between">
            <label class="text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Diversified Business Activities <span class="text-rose-400">*</span>
            </label>
            <span class="text-[11px] text-slate-400">% calculated automatically</span>
          </div>

          <div id="revenue-list" class="space-y-3">
            <!-- Row 1 Default -->
            <div class="revenue-row bg-slate-800/40 border border-slate-800 rounded-2xl p-4 flex flex-col sm:flex-row gap-3 items-start sm:items-center">
              <span class="w-6 h-6 rounded-full bg-slate-800 text-amber-400 font-mono text-xs font-bold flex items-center justify-center shrink-0">
                1
              </span>
              <input
                type="text"
                name="revenue[0][activity]"
                required
                placeholder="Business Activity Name"
                class="w-full sm:w-1/2 bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400"
              />
              <input
                type="text"
                inputmode="decimal"
                name="revenue[0][revenue]"
                required
                placeholder="Revenue (Rs.)"
                class="rev-amount-input w-full sm:w-1/3 bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400"
              />
              <div class="row-pct-badge font-mono text-xs font-bold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-3 py-2 rounded-xl text-center min-w-[70px]">
                0.00%
              </div>
              <button
                type="button"
                class="remove-row-btn text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 p-2 rounded-lg text-xs transition-colors shrink-0 hidden"
                title="Remove Row"
              >
                ✕
              </button>
            </div>
          </div>

          <button
            type="button"
            id="add-revenue-btn"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-700 bg-slate-800/50 hover:bg-slate-800 text-xs font-semibold text-slate-300 hover:text-white transition-colors"
          >
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Add another business activity</span>
          </button>
        </div>

        <!-- Live Metrics Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-800">
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4">
            <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Diversification Revenue</div>
            <div id="live-total-revenue" class="text-xl font-bold font-mono text-white mt-1">Rs. 0.00</div>
          </div>
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4">
            <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Combined % of Total Revenue</div>
            <div id="live-combined-percent" class="text-xl font-bold font-mono text-amber-400 mt-1">0.00%</div>
          </div>
        </div>

        <div class="flex justify-between pt-6 border-t border-slate-800">
          <button
            type="button"
            class="prev-step-btn px-6 py-3 rounded-xl border border-slate-700 bg-slate-800/60 hover:bg-slate-800 text-slate-300 font-semibold text-sm transition-colors"
          >
            Back
          </button>
          <button
            type="button"
            class="next-step-btn px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm flex items-center gap-2 shadow-lg shadow-amber-500/20 transition-all"
          >
            <span>Continue to Step 4</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </section>

      <!-- STEP 4: Gross Profit Margin Improvement -->
      <section class="wizard-step hidden bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6" data-step="4">
        <div>
          <h2 class="text-xl font-bold text-white">4. Gross Profit Margin Improvement</h2>
          <p class="text-slate-400 text-xs mt-1">Select the verified margin outcome achieved via diversification.</p>
        </div>

        <div class="space-y-3" id="margin-options-group">
          <label class="flex items-center gap-3.5 p-4 rounded-2xl bg-slate-800/40 border border-slate-800 hover:border-amber-400/60 cursor-pointer transition-colors">
            <input
              type="radio"
              name="gross_profit_margin_option"
              value="Improved by more than 5%"
              required
              class="w-4 h-4 text-amber-500 bg-slate-800 border-slate-700 focus:ring-amber-400"
            />
            <span class="text-sm font-semibold text-white">Improved by more than 5%</span>
          </label>

          <label class="flex items-center gap-3.5 p-4 rounded-2xl bg-slate-800/40 border border-slate-800 hover:border-amber-400/60 cursor-pointer transition-colors">
            <input
              type="radio"
              name="gross_profit_margin_option"
              value="Improved by 3% to less than 5%"
              required
              class="w-4 h-4 text-amber-500 bg-slate-800 border-slate-700 focus:ring-amber-400"
            />
            <span class="text-sm font-semibold text-white">Improved by 3% to less than 5%</span>
          </label>

          <label class="flex items-center gap-3.5 p-4 rounded-2xl bg-slate-800/40 border border-slate-800 hover:border-amber-400/60 cursor-pointer transition-colors">
            <input
              type="radio"
              name="gross_profit_margin_option"
              value="Improved by 1% to less than 3%"
              required
              class="w-4 h-4 text-amber-500 bg-slate-800 border-slate-700 focus:ring-amber-400"
            />
            <span class="text-sm font-semibold text-white">Improved by 1% to less than 3%</span>
          </label>

          <label class="flex items-center gap-3.5 p-4 rounded-2xl bg-slate-800/40 border border-slate-800 hover:border-amber-400/60 cursor-pointer transition-colors">
            <input
              type="radio"
              name="gross_profit_margin_option"
              value="Improved by less than 1%"
              required
              class="w-4 h-4 text-amber-500 bg-slate-800 border-slate-700 focus:ring-amber-400"
            />
