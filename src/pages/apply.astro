      <!-- STEP 5: Return on Investment (ROI) & Payback -->
      <section class="wizard-step hidden bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6" data-step="5">
        <div>
          <h2 class="text-xl font-bold text-white">5. Return on Investment (ROI) & Payback</h2>
          <p class="text-slate-400 text-xs mt-1">ROI and estimated payback period are calculated automatically.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Total Investment in Diversification (Rs.) <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              inputmode="decimal"
              name="total_investment"
              id="total_investment"
              required
              placeholder="e.g. 5,000,000"
              class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
            />
            <span class="text-[11px] text-slate-400 block">Includes machinery, tech, R&D, and market launch.</span>
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Operating Profit from Diversification (Rs.) <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              inputmode="decimal"
              name="operating_profit"
              id="operating_profit"
              required
              placeholder="e.g. 1,000,000"
              class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
            />
            <span class="text-[11px] text-slate-400 block">Use annualized operating profit if newly launched.</span>
          </div>
        </div>

        <!-- Metric Display Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-4 border-t border-slate-800">
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Return on Investment (ROI)</div>
            <div id="live-roi-display" class="text-3xl font-extrabold font-mono text-emerald-400 mt-2">0.00%</div>
            <span class="text-[11px] text-slate-500 mt-1 block">(Operating Profit ÷ Investment) × 100</span>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Estimated Payback Period</div>
            <div id="live-payback-display" class="text-3xl font-extrabold font-mono text-blue-400 mt-2">—</div>
            <span class="text-[11px] text-slate-500 mt-1 block">Investment ÷ Operating Profit (Years)</span>
          </div>
        </div>

        <div class="flex justify-between pt-6 border-t border-slate-800">
          <button
            type="button"
            class="prev-step-btn px-6 py-3 rounded-xl border border-slate-700 bg-slate-800/60 hover:bg-slate-800 text-slate-300 font-semibold text-sm transition-colors"
          >
            Back
          </button>
          <button
            type="button"
            class="next-step-btn px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm flex items-center gap-2 shadow-lg shadow-amber-500/20 transition-all"
          >
            <span>Continue to Step 6</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </section>

      <!-- STEP 6: Declaration & Signature -->
      <section class="wizard-step hidden bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6" data-step="6">
        <div>
          <h2 class="text-xl font-bold text-white">6. Declaration & Biometric Signature</h2>
          <p class="text-slate-400 text-xs mt-1">Review legal declaration and sign before final statutory submission.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Authorized Signatory Name <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              name="declaration_name"
              required
              placeholder="e.g. Priyantha Jayasuriya"
              class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Official Designation <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              name="declaration_designation"
              required
              placeholder="e.g. Chief Executive Officer"
              class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
            />
          </div>

          <div class="sm:col-span-2 space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Date of Declaration <span class="text-rose-400">*</span>
            </label>
            <input
              type="date"
              name="declaration_date"
              id="declaration_date"
              required
              class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
            />
          </div>
        </div>

        <!-- Digital Signature -->
        <div class="pt-4 border-t border-slate-800 space-y-2">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Digital Biometric Signature <span class="text-rose-400">*</span>
          </label>
          <SignaturePad id="signature_data" name="signature_data" />
        </div>

        <!-- Affirmation Checkbox -->
        <div class="pt-2">
          <label class="flex items-start gap-3.5 p-4 rounded-2xl bg-amber-500/5 border border-amber-500/30 cursor-pointer">
            <input
              type="checkbox"
              name="declaration_confirmed"
              value="true"
              required
              class="mt-1 w-4 h-4 rounded text-amber-500 bg-slate-800 border-slate-700 focus:ring-amber-400"
            />
            <span class="text-xs text-slate-300 leading-relaxed">
              <strong class="text-white block font-semibold mb-1">I/We confirm and certify the declaration above.</strong>
              All information provided is true, accurate, and relates exclusively to verified New Products to New Markets diversification and strategically linked long-term capital investments for the 2025/26 evaluation period.
            </span>
          </label>
        </div>

        <div class="flex justify-between items-center pt-6 border-t border-slate-800">
          <button
            type="button"
            class="prev-step-btn px-6 py-3 rounded-xl border border-slate-700 bg-slate-800/60 hover:bg-slate-800 text-slate-300 font-semibold text-sm transition-colors"
          >
            Back
          </button>
          <button
            type="submit"
            id="submit-app-btn"
            class="px-8 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-slate-950 font-extrabold text-sm flex items-center gap-2.5 shadow-xl shadow-emerald-500/25 transition-all"
          >
            <span id="submit-btn-text">Submit Official Application</span>
            <svg id="submit-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </div>
      </section>
    </form>
  </div>
</Layout>

<script>
  // Full reactive client-side multi-step wizard controller
  function initWizard() {
    let currentStep = 1;
    const totalSteps = 6;
    const form = document.getElementById('award-form') as HTMLFormElement | null;
    const errorBanner = document.getElementById('error-banner');
    const errorMessage = document.getElementById('error-message');
    const draftBanner = document.getElementById('draft-banner');
    const clearDraftBtn = document.getElementById('clear-draft-btn');
    const progressBar = document.getElementById('step-progress-bar');
    const stepCounter = document.getElementById('step-counter');
    const submitBtn = document.getElementById('submit-app-btn') as HTMLButtonElement | null;
    const submitText = document.getElementById('submit-btn-text');
    const submitSpinner = document.getElementById('submit-spinner');

    if (!form) return;

    // Set default date to today
    const dateInput = document.getElementById('declaration_date') as HTMLInputElement | null;
    if (dateInput && !dateInput.value) {
      dateInput.value = new Date().toISOString().split('T')[0]!;
    }

    // --- Strict Numeric Formatting & Input Keystroke Helpers ---
    function formatWithCommas(val: string | number): string {
      if (val === '' || val === null || val === undefined) return '';
      const str = String(val);
      const parts = str.split('.');
      const intPart = parts[0]?.replace(/[^0-9]/g, '') || '';
      const formattedInt = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return parts.length > 1 ? `${formattedInt}.${parts.slice(1).join('').replace(/[^0-9]/g, '')}` : formattedInt;
    }

    function parseNumber(val?: string | number): number {
      if (val === '' || val === null || val === undefined) return 0;
      const clean = String(val).replace(/,/g, '').trim();
      const n = parseFloat(clean);
      return isNaN(n) ? 0 : n;
    }

    function formatNumberDisplay(n: number): string {
      return n.toLocaleString('en-LK', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Attach strict numeric keystroke restrictions and comma formatting to an input
    function attachNumericFilter(input: HTMLInputElement) {
      if ((input as any)._numericAttached) return;
      (input as any)._numericAttached = true;

      // Keydown filter: allow digits, one period, navigation, shortcuts
      input.addEventListener('keydown', (e: KeyboardEvent) => {
        const allowedKeys = [
          'Backspace', 'Delete', 'Tab', 'Escape', 'Enter',
          'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown',
          'Home', 'End'
        ];
        if (allowedKeys.includes(e.key) || e.ctrlKey || e.metaKey) {
          return;
        }
        // Digits 0-9
        if (/^[0-9]$/.test(e.key)) {
          return;
        }
        // Only one decimal point allowed (or allow if period is within selected text that will be replaced)
        if (e.key === '.') {
          const selStart = input.selectionStart || 0;
          const selEnd = input.selectionEnd || 0;
          const selectedText = input.value.substring(selStart, selEnd);
          if (!input.value.includes('.') || selectedText.includes('.')) {
            return;
          }
        }
        // Block alphabets, spaces, symbols
        e.preventDefault();
      });

      // On input: format with commas while preserving caret position
      input.addEventListener('input', () => {
        const orig = input.value;
        const selStart = input.selectionStart || 0;

        // Count numeric characters before cursor
        let digitsBefore = 0;
        for (let i = 0; i < selStart; i++) {
          if (/[0-9.]/.test(orig[i]!)) digitsBefore++;
        }

        // Clean input: strip all non-digit and non-period characters, keep single period
        const rawClean = orig.replace(/[^0-9.]/g, '');
        const firstDot = rawClean.indexOf('.');
        let sanitized = rawClean;
        if (firstDot !== -1) {
          sanitized = rawClean.slice(0, firstDot + 1) + rawClean.slice(firstDot + 1).replace(/\./g, '');
        }

        // Format with thousand commas
        const formatted = formatWithCommas(sanitized);
        input.value = formatted;

        // Restore caret position based on digit count
        let newPos = 0;
        let digitsFound = 0;
        for (let i = 0; i < formatted.length; i++) {
          if (digitsFound >= digitsBefore) break;
          if (/[0-9.]/.test(formatted[i]!)) digitsFound++;
          newPos = i + 1;
        }
        input.setSelectionRange(newPos, newPos);

        recalculateLive();
        saveDraft();
      });
    }

    // Attach to existing financial inputs
    function setupAllNumericInputs() {
      const inputs = [
        document.getElementById('total_company_revenue') as HTMLInputElement | null,
        document.getElementById('total_investment') as HTMLInputElement | null,
        document.getElementById('operating_profit') as HTMLInputElement | null,
        ...document.querySelectorAll('.rev-amount-input'),
      ];
      inputs.forEach(inp => {
        if (inp && inp instanceof HTMLInputElement) {
          attachNumericFilter(inp);
        }
      });
    }

    setupAllNumericInputs();

    // Step navigation
    function showStep(step: number) {
      currentStep = step;
      document.querySelectorAll('.wizard-step').forEach(el => {
        const s = parseInt(el.getAttribute('data-step') || '0', 10);
        if (s === step) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // If Step 6 became visible, explicitly trigger canvas resize & redraw
      if (step === 6) {
        if (typeof (window as any).resizeSignatureCanvas === 'function') {
          (window as any).resizeSignatureCanvas();
        }
      }

      // Update progress bar
      if (progressBar) {
        progressBar.style.width = `${(step / totalSteps) * 100}%`;
      }
      if (stepCounter) {
        stepCounter.textContent = `Step ${step} of ${totalSteps}`;
      }

      // Update step labels
      document.querySelectorAll('.step-lbl').forEach(el => {
        const s = parseInt(el.getAttribute('data-step') || '0', 10);
        if (s === step) {
          el.className = 'step-lbl text-amber-400 font-bold';
        } else if (s < step) {
          el.className = 'step-lbl text-slate-300';
        } else {
          el.className = 'step-lbl text-slate-500';
        }
      });

      // Hide error banner when switching steps
      if (errorBanner) errorBanner.classList.add('hidden');
      window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    function showError(msg: string) {
      if (errorMessage) errorMessage.textContent = msg;
      if (errorBanner) errorBanner.classList.remove('hidden');
      window.scrollTo({ top: 80, behavior: 'smooth' });
    }

    function highlightInputError(inp: HTMLElement | null) {
      if (!inp) return;
      inp.classList.remove('border-slate-700');
      inp.classList.add('border-rose-500');
      inp.addEventListener('input', () => {
        inp.classList.remove('border-rose-500');
        inp.classList.add('border-slate-700');
      }, { once: true });
    }

    // Step validation rules
    function validateStep(step: number): boolean {
      if (step === 1) {
        const companyName = (form?.elements.namedItem('company_name') as HTMLInputElement)?.value.trim();
        const nature = (form?.elements.namedItem('nature_operations') as HTMLSelectElement)?.value;
        const contact = (form?.elements.namedItem('contact_name_designation') as HTMLInputElement)?.value.trim();
        const email = (form?.elements.namedItem('contact_email') as HTMLInputElement)?.value.trim();
        const phone = (form?.elements.namedItem('contact_phone') as HTMLInputElement)?.value.trim();

        if (!companyName) { showError('Company Name is required.'); return false; }
        if (!nature) { showError('Please select the Nature of Operations.'); return false; }
        if (!contact) { showError('Contact Person Name & Designation is required.'); return false; }
        if (!email || !email.includes('@')) { showError('A valid Contact Email is required.'); return false; }
        if (!phone) { showError('Telephone number is required.'); return false; }
        return true;
      }

      if (step === 2) {
        const newProducts = (form?.elements.namedItem('new_products_services') as HTMLInputElement)?.checked;
        const newMarket = (form?.elements.namedItem('new_market_entered') as HTMLInputElement)?.checked;
        if (!newProducts || !newMarket) {
          showError('Both mandatory diversification conditions (New Products & New Market) must be confirmed.');
          return false;
        }

        // Validate products repeater
        const productRows = form?.querySelectorAll('#products-list .product-row') as NodeListOf<HTMLElement>;

        // Clear existing error borders on product inputs
        productRows.forEach(row => {
          row.querySelectorAll('input').forEach(inp => {
            inp.classList.remove('border-rose-500');
            inp.classList.add('border-slate-700');
          });
        });

        if (!productRows || productRows.length === 0) {
          showError('Please add at least one product/service with a description.');
          return false;
        }

        for (let i = 0; i < productRows.length; i++) {
          const row = productRows[i]!;
          const nameInp = row.querySelector('input[name*="[name]"]') as HTMLInputElement | null;
          const descInp = row.querySelector('input[name*="[description]"]') as HTMLInputElement | null;

          const nameVal = nameInp?.value.trim() || '';
          const descVal = descInp?.value.trim() || '';

          // If row is completely empty
          if (!nameVal && !descVal) {
            showError('Please add at least one product/service with a description.');
            if (nameInp) highlightInputError(nameInp);
            if (descInp) highlightInputError(descInp);
            nameInp?.focus();
            return false;
          }

          // If name is empty
          if (!nameVal) {
            showError('Please add at least one product/service with a description.');
            if (nameInp) {
              highlightInputError(nameInp);
              nameInp.focus();
            }
            return false;
          }

          // If description is empty
          if (!descVal) {
            showError('Please add at least one product/service with a description.');
            if (descInp) {
              highlightInputError(descInp);
              descInp.focus();
            }
            return false;
          }
        }

        const marketDetails = (form?.elements.namedItem('new_market_details') as HTMLTextAreaElement)?.value.trim();
        if (!marketDetails) {
          showError('Please describe the new market entered.');
          const marketInp = form?.elements.namedItem('new_market_details') as HTMLTextAreaElement | null;
          if (marketInp) {
            highlightInputError(marketInp);
            marketInp.focus();
          }
          return false;
        }
        return true;
      }

      if (step === 3) {
        const totalRevInp = form?.elements.namedItem('total_company_revenue') as HTMLInputElement | null;
        const totalRev = parseNumber(totalRevInp?.value);
        if (totalRev <= 0) {
          showError('Total Company Revenue (Audited) is required and must be greater than zero.');
          totalRevInp?.focus();
          return false;
        }

        const revRows = form?.querySelectorAll('.revenue-row') as NodeListOf<HTMLElement>;
        let hasValidRow = false;
        for (let i = 0; i < revRows.length; i++) {
          const row = revRows[i]!;
          const actInp = row.querySelector('input[name*="[activity]"]') as HTMLInputElement | null;
          const amtInp = row.querySelector('.rev-amount-input') as HTMLInputElement | null;
          const actVal = actInp?.value.trim() || '';
          const amtVal = parseNumber(amtInp?.value);

          if (!actVal && amtVal <= 0) {
            continue;
          }
          if (!actVal) {
            showError('Please enter the Business Activity description for row ' + (i + 1) + '.');
            actInp?.focus();
            return false;
          }
          if (amtVal <= 0) {
            showError('Please enter a valid numeric revenue amount for row ' + (i + 1) + '.');
            amtInp?.focus();
            return false;
          }
          hasValidRow = true;
        }

        if (!hasValidRow) {
          showError('Please add at least one diversified business activity with revenue.');
          return false;
        }
        return true;
      }

      if (step === 4) {
        const option = form?.querySelector('input[name="gross_profit_margin_option"]:checked');
        if (!option) {
          showError('Please select a Gross Profit Margin Improvement category.');
          return false;
        }
        return true;
      }

      if (step === 5) {
        const invInp = form?.elements.namedItem('total_investment') as HTMLInputElement | null;
        const profitInp = form?.elements.namedItem('operating_profit') as HTMLInputElement | null;
        const inv = parseNumber(invInp?.value);
        const profit = parseNumber(profitInp?.value);

        if (!invInp?.value.trim() || inv <= 0) {
          showError('Total Investment in Diversification is required and must be greater than zero.');
          invInp?.focus();
          return false;
        }
        if (!profitInp?.value.trim() || profit < 0) {
          showError('Operating Profit from Diversification is required (cannot be negative).');
          profitInp?.focus();
          return false;
        }
        return true;
      }

      if (step === 6) {
        const declName = (form?.elements.namedItem('declaration_name') as HTMLInputElement)?.value.trim();
        const declDesig = (form?.elements.namedItem('declaration_designation') as HTMLInputElement)?.value.trim();
        const declDate = (form?.elements.namedItem('declaration_date') as HTMLInputElement)?.value.trim();
        const confirmed = (form?.elements.namedItem('declaration_confirmed') as HTMLInputElement)?.checked;
        const signature = (form?.elements.namedItem('signature_data') as HTMLInputElement)?.value;
        const isBlank = typeof (window as any).isSignatureBlank === 'function' ? (window as any).isSignatureBlank() : (!signature || signature.length < 50);

        if (!declName) { showError('Authorized Signatory Name is required.'); return false; }
        if (!declDesig) { showError('Official Designation is required.'); return false; }
        if (!declDate) { showError('Date of Declaration is required.'); return false; }
        if (isBlank) {
          showError('Digital biometric signature is required. Please sign inside the designated box.');
          document.getElementById('sig-canvas')?.focus();
          return false;
        }
        if (!confirmed) {
          showError('Please confirm the legal declaration checkbox before submitting.');
          return false;
        }
        return true;
      }

      return true;
    }

    // Live Calculations
    function recalculateLive() {
      // Step 3 Live Calculations
      const totalRev = parseNumber((form?.elements.namedItem('total_company_revenue') as HTMLInputElement)?.value);
      const revRows = form?.querySelectorAll('.revenue-row') as NodeListOf<HTMLElement>;
      let divTotal = 0;

      revRows.forEach(row => {
        const amtInput = row.querySelector('.rev-amount-input') as HTMLInputElement | null;
        const pctBadge = row.querySelector('.row-pct-badge') as HTMLElement | null;
        const amt = parseNumber(amtInput?.value);
        divTotal += amt;
        const pct = totalRev > 0 ? (amt / totalRev) * 100 : 0;
        if (pctBadge) pctBadge.textContent = `${pct.toFixed(2)}%`;
      });

      const liveTotalRev = document.getElementById('live-total-revenue');
      const liveCombPct = document.getElementById('live-combined-percent');
      if (liveTotalRev) liveTotalRev.textContent = `Rs. ${formatNumberDisplay(divTotal)}`;
      if (liveCombPct) {
        const combPct = totalRev > 0 ? (divTotal / totalRev) * 100 : 0;
        liveCombPct.textContent = `${combPct.toFixed(2)}%`;
      }

      // Step 5 Live Calculations (ROI & Payback)
      const inv = parseNumber((form?.elements.namedItem('total_investment') as HTMLInputElement)?.value);
      const profit = parseNumber((form?.elements.namedItem('operating_profit') as HTMLInputElement)?.value);

      const roiDisplay = document.getElementById('live-roi-display');
      const paybackDisplay = document.getElementById('live-payback-display');

      if (roiDisplay) {
        const roi = inv > 0 ? (profit / inv) * 100 : 0;
        roiDisplay.textContent = `${roi.toFixed(2)}%`;
      }

      if (paybackDisplay) {
        if (profit > 0 && inv > 0) {
          const payback = inv / profit;
          paybackDisplay.textContent = `${payback.toFixed(2)} Years`;
        } else {
          paybackDisplay.textContent = '—';
        }
      }
    }

    // General input listener
    form.addEventListener('input', () => {
      recalculateLive();
      saveDraft();
    });

    // Add/Remove Products Repeater
    const addProductBtn = document.getElementById('add-product-btn');
    const productsList = document.getElementById('products-list');
    addProductBtn?.addEventListener('click', () => {
      if (!productsList) return;
      const count = productsList.querySelectorAll('.product-row').length;
      const row = document.createElement('div');
      row.className = 'product-row bg-slate-800/40 border border-slate-800 rounded-2xl p-4 flex flex-col sm:flex-row gap-3 items-start sm:items-center animate-fade-in';
      row.innerHTML = `
        <span class="w-6 h-6 rounded-full bg-slate-800 text-amber-400 font-mono text-xs font-bold flex items-center justify-center shrink-0">
          ${count + 1}
        </span>
        <input
          type="text"
          name="products[${count}][name]"
          required
          placeholder="Product / Service Name"
          class="w-full sm:w-1/3 bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400"
        />
        <input
          type="text"
          name="products[${count}][description]"
          required
          placeholder="Brief description of product, features, and target segment"
          class="w-full sm:flex-1 bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400"
        />
        <button
          type="button"
          class="remove-row-btn text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 p-2 rounded-lg text-xs transition-colors shrink-0"
          title="Remove Item"
        >
          ✕
        </button>
      `;
      productsList.appendChild(row);
      updateRemoveButtons(productsList, '.product-row');
      saveDraft();
    });

    // Add/Remove Revenue Repeater
    const addRevenueBtn = document.getElementById('add-revenue-btn');
    const revenueList = document.getElementById('revenue-list');
    addRevenueBtn?.addEventListener('click', () => {
      if (!revenueList) return;
      const count = revenueList.querySelectorAll('.revenue-row').length;
      const row = document.createElement('div');
      row.className = 'revenue-row bg-slate-800/40 border border-slate-800 rounded-2xl p-4 flex flex-col sm:flex-row gap-3 items-start sm:items-center animate-fade-in';
      row.innerHTML = `
        <span class="w-6 h-6 rounded-full bg-slate-800 text-amber-400 font-mono text-xs font-bold flex items-center justify-center shrink-0">
          ${count + 1}
        </span>
        <input
          type="text"
          name="revenue[${count}][activity]"
          required
          placeholder="Business Activity Name"
          class="w-full sm:w-1/2 bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400"
        />
        <input
          type="text"
          inputmode="decimal"
          name="revenue[${count}][revenue]"
          required
          placeholder="Revenue (Rs.)"
          class="rev-amount-input w-full sm:w-1/3 bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400"
        />
        <div class="row-pct-badge font-mono text-xs font-bold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-3 py-2 rounded-xl text-center min-w-[70px]">
          0.00%
        </div>
        <button
          type="button"
          class="remove-row-btn text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 p-2 rounded-lg text-xs transition-colors shrink-0"
          title="Remove Row"
        >
          ✕
        </button>
      `;
      revenueList.appendChild(row);
      updateRemoveButtons(revenueList, '.revenue-row');

      // Attach strict numeric filter to new input
      const newAmtInp = row.querySelector('.rev-amount-input') as HTMLInputElement | null;
      if (newAmtInp) attachNumericFilter(newAmtInp);

      recalculateLive();
      saveDraft();
    });

    // Delegate row removal
    document.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('remove-row-btn')) {
        const row = target.closest('.product-row, .revenue-row');
        const container = row?.parentElement;
        row?.remove();
        if (container) {
          updateRemoveButtons(container, container.id === 'products-list' ? '.product-row' : '.revenue-row');
        }
        recalculateLive();
        saveDraft();
      }
    });

    function updateRemoveButtons(container: HTMLElement, selector: string) {
      const rows = container.querySelectorAll(selector);
      rows.forEach((r, idx) => {
        const numSpan = r.querySelector('span');
        if (numSpan) numSpan.textContent = String(idx + 1);
        const rmBtn = r.querySelector('.remove-row-btn');
        if (rmBtn) {
          if (rows.length > 1) {
            rmBtn.classList.remove('hidden');
          } else {
            rmBtn.classList.add('hidden');
          }
        }
      });
    }

    // Step button handlers
    document.querySelectorAll('.next-step-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (validateStep(currentStep)) {
          showStep(currentStep + 1);
        }
      });
    });

    document.querySelectorAll('.prev-step-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (currentStep > 1) {
          showStep(currentStep - 1);
        }
      });
    });

    // LocalStorage Draft Management
    const DRAFT_KEY = 'bdc_award_draft_2025';

    function saveDraft() {
      try {
        const formData = new FormData(form);
        const obj: Record<string, any> = {};
        formData.forEach((val, key) => {
          if (key === 'signature_data' || key.includes('files')) return;
          obj[key] = val;
        });
        localStorage.setItem(DRAFT_KEY, JSON.stringify(obj));
      } catch {}
    }

    function restoreDraft() {
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (!raw) return;
        const data = JSON.parse(raw);
        let restoredCount = 0;

        Object.keys(data).forEach(key => {
          const el = form?.elements.namedItem(key);
          if (el) {
            if (el instanceof RadioNodeList) {
              el.value = data[key];
            } else if (el instanceof HTMLInputElement) {
              if (el.type === 'checkbox') {
                el.checked = data[key] === 'true' || data[key] === true;
              } else {
                // Format numeric inputs with commas upon restore
                if (['total_company_revenue', 'total_investment', 'operating_profit'].includes(key) || key.includes('[revenue]')) {
                  el.value = formatWithCommas(data[key]);
                } else {
                  el.value = data[key];
                }
              }
            } else if (el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement) {
              el.value = data[key];
            }
            restoredCount++;
          }
        });

        if (restoredCount > 0 && draftBanner) {
          draftBanner.classList.remove('hidden');
          setupAllNumericInputs();
          recalculateLive();
        }
      } catch {}
    }

    clearDraftBtn?.addEventListener('click', () => {
      localStorage.removeItem(DRAFT_KEY);
      if (draftBanner) draftBanner.classList.add('hidden');
      form.reset();
      recalculateLive();
    });

    restoreDraft();

    // Form Submission Handler
    form.addEventListener('submit', async e => {
      e.preventDefault();

      // Ensure signature canvas exports latest data before validating Step 6
      const sigPad = document.getElementById('sig-canvas') as HTMLCanvasElement | null;
      const sigInput = document.getElementById('signature_data') as HTMLInputElement | null;
      if (sigPad && sigInput && typeof (window as any).isSignatureBlank === 'function' && !(window as any).isSignatureBlank()) {
        sigInput.value = sigPad.toDataURL('image/png');
      }

      if (!validateStep(6)) {
        return;
      }

      // Check file attachments payload limits
      const fileInputs = form.querySelectorAll('input[type="file"]') as NodeListOf<HTMLInputElement>;
      let totalFileSize = 0;
      for (const fi of fileInputs) {
        if (fi.files) {
          for (let i = 0; i < fi.files.length; i++) {
            const file = fi.files[i]!;
            if (file.size > 5 * 1024 * 1024) {
              showError(`File "${file.name}" exceeds the maximum allowed size of 5 MB.`);
              return;
            }
            totalFileSize += file.size;
          }
        }
      }
      if (totalFileSize > 25 * 1024 * 1024) {
        showError('Total uploaded files exceed the maximum allowed payload limit (25 MB).');
        return;
      }

      // Enter loading state
      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Submitting & Generating Dossier...';
      if (submitSpinner) submitSpinner.classList.remove('hidden');
      if (errorBanner) errorBanner.classList.add('hidden');

      function resetSubmitBtn() {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Submit Official Application';
        if (submitSpinner) submitSpinner.classList.add('hidden');
      }

      try {
        const formData = new FormData(form);

        // Sanitize numeric fields: strip commas before sending payload to backend
        ['total_company_revenue', 'total_investment', 'operating_profit'].forEach(k => {
          const val = formData.get(k);
          if (typeof val === 'string') {
            formData.set(k, val.replace(/,/g, '').trim());
          }
        });

        // Strip commas from repeater revenue rows
        for (const [k, val] of Array.from(formData.entries())) {
          if (k.startsWith('revenue[') && k.endsWith('][revenue]') && typeof val === 'string') {
            formData.set(k, val.replace(/,/g, '').trim());
          }
        }

        // Setup 60-second AbortController timeout
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 60000);

        let res: Response;
        try {
          // Use relative endpoint to avoid cross-origin protocol/port issues
          res = await fetch('/api/submit', {
            method: 'POST',
            body: formData,
            signal: controller.signal,
          });
        } catch (fetchErr: any) {
          clearTimeout(timeoutId);
          console.error('[Submit Network Exception]', fetchErr);
          if (fetchErr?.name === 'AbortError') {
            showError('Submission request timed out. Please check your network connection and file attachments.');
          } else {
            showError(fetchErr?.message ? `Network error: ${fetchErr.message}` : 'A network error occurred while submitting. Please check your connection.');
          }
          resetSubmitBtn();
          return;
        }
        clearTimeout(timeoutId);

        // Check response.ok before attempting response.json()
        if (res.ok) {
          let data: any = null;
          try {
            data = await res.json();
          } catch (jsonErr) {
            console.error('[JSON Parse Error on OK response]', jsonErr);
            const rawText = await res.text().catch(() => '');
            showError('Invalid response from server: ' + (rawText ? rawText.slice(0, 150) : 'Malformed JSON'));
            resetSubmitBtn();
            return;
          }

          if (data?.success) {
            // Clear saved draft on successful submission
            localStorage.removeItem(DRAFT_KEY);

            // Store submission data in sessionStorage for success page
            sessionStorage.setItem('submitted_reference', data.reference || '');
            sessionStorage.setItem('submitted_email', data.email || '');
            sessionStorage.setItem('submitted_download_url', data.downloadUrl || '');
            sessionStorage.setItem('submitted_pdf_ready', data.pdfReady ? '1' : '0');
            sessionStorage.setItem('submitted_email_sent', data.emailSent ? '1' : '0');

            window.location.href = `/success?ref=${encodeURIComponent(data.reference)}`;
          } else {
            showError(data?.message || 'Submission failed. Please check your details.');
            resetSubmitBtn();
          }
        } else {
          // Server returned error (e.g. 422, 429, 500) or unformatted HTML/PHP fatal error
          let errMsg = '';
          const contentType = res.headers.get('content-type') || '';
          if (contentType.includes('application/json')) {
            try {
              const errData = await res.json();
              errMsg = errData?.error || errData?.message || (errData?.errors ? Object.values(errData.errors).flat().join(', ') : '');
              if (errData?.field) {
                const f = String(errData.field);
                if (f.includes('company') || f.includes('contact') || f.includes('operations')) showStep(1);
                else if (f.includes('product') || f.includes('market')) showStep(2);
                else if (f.includes('revenue')) showStep(3);
                else if (f.includes('gross') || f.includes('margin')) showStep(4);
                else if (f.includes('investment') || f.includes('profit')) showStep(5);
                else if (f.includes('declaration') || f.includes('signature')) showStep(6);
              }
            } catch {
              errMsg = await res.text().catch(() => '');
            }
          } else {
            errMsg = await res.text().catch(() => '');
          }

          if (!errMsg) {
            errMsg = `Server error (Status: ${res.status} ${res.statusText || ''})`;
          }
          // Strip any HTML tags from error message
          const cleanErrMsg = errMsg.replace(/<[^>]*>?/gm, ' ').replace(/\s+/g, ' ').trim();
          console.error('[Submission Server Error]', res.status, cleanErrMsg);
          showError(cleanErrMsg.slice(0, 300) || `Server error (${res.status})`);
          resetSubmitBtn();
        }
      } catch (err: any) {
        console.error('[Submit Handler Error]', err);
        showError(err?.message ? `Submission Error: ${err.message}` : 'An unexpected error occurred while submitting. Please check your details.');
        resetSubmitBtn();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWizard);
  } else {
    initWizard();
  }
</script>

