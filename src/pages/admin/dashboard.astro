  <!-- Client-side real-time Search, Filter & Quick View Script -->
  <script>
    const searchInput = document.getElementById(
      "searchInput",
    ) as HTMLInputElement | null;
    const statusFilter = document.getElementById(
      "statusFilter",
    ) as HTMLSelectElement | null;
    const noMatchMessage = document.getElementById("noMatchMessage");
    const showingCount = document.getElementById("showingCount");

    function applyFilter() {
      const query = (searchInput?.value ?? "").toLowerCase().trim();
      const selectedStatus = (statusFilter?.value ?? "ALL").toUpperCase();
      const currentRows =
        document.querySelectorAll<HTMLTableRowElement>(".application-row");
      const totalRows = currentRows.length;

      let visibleCount = 0;

      currentRows.forEach((row) => {
        const ref = row.getAttribute("data-reference") ?? "";
        const company = row.getAttribute("data-company") ?? "";
        const contact = row.getAttribute("data-contact") ?? "";
        const designation = row.getAttribute("data-designation") ?? "";
        const email = row.getAttribute("data-email") ?? "";
        const status = row.getAttribute("data-status") ?? "";

        const matchesQuery =
          !query ||
          ref.includes(query) ||
          company.includes(query) ||
          contact.includes(query) ||
          designation.includes(query) ||
          email.includes(query);
        const matchesStatus =
          selectedStatus === "ALL" || status === selectedStatus;

        if (matchesQuery && matchesStatus) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      });

      if (noMatchMessage) {
        if (visibleCount === 0 && totalRows > 0) {
          noMatchMessage.classList.remove("hidden");
        } else {
          noMatchMessage.classList.add("hidden");
        }
      }

      if (showingCount) {
        showingCount.textContent = `Showing ${visibleCount} of ${totalRows} submissions`;
      }
    }

    searchInput?.addEventListener("input", applyFilter);
    statusFilter?.addEventListener("change", applyFilter);

    // Toast Notification Management
    const dashboardToast = document.getElementById("dashboardToast");
    const dashboardToastTitle = document.getElementById("dashboardToastTitle");
    const dashboardToastMsg = document.getElementById("dashboardToastMsg");
    let toastTimeout: ReturnType<typeof setTimeout> | null = null;

    function showToast(title: string, message: string) {
      if (!dashboardToast || !dashboardToastTitle || !dashboardToastMsg) return;
      if (toastTimeout) clearTimeout(toastTimeout);

      dashboardToastTitle.textContent = title;
      dashboardToastMsg.textContent = message;
      dashboardToast.classList.remove("hidden");

      // Animate in
      requestAnimationFrame(() => {
        dashboardToast.classList.remove("translate-y-4", "opacity-0");
        dashboardToast.classList.add("translate-y-0", "opacity-100");
      });

      toastTimeout = setTimeout(() => {
        dashboardToast.classList.remove("translate-y-0", "opacity-100");
        dashboardToast.classList.add("translate-y-4", "opacity-0");
        setTimeout(() => {
          dashboardToast.classList.add("hidden");
        }, 300);
      }, 3500);
    }

    // Quick View Modal Management
    const detailModal = document.getElementById("detailModal");
    const modalBackdrop = document.getElementById("modalBackdrop");
    const closeModalBtn = document.getElementById("closeModalBtn");

    const modalReference = document.getElementById("modalReference");
    const modalStatus = document.getElementById("modalStatus");
    const modalCompany = document.getElementById("modalCompany");
    const modalSubmitted = document.getElementById("modalSubmitted");
    const modalContactName = document.getElementById("modalContactName");
    const modalContactDesignation = document.getElementById(
      "modalContactDesignation",
    );
    const modalContactEmail = document.getElementById("modalContactEmail");
    const modalContactPhone = document.getElementById("modalContactPhone");
    const modalDeclarationName = document.getElementById(
      "modalDeclarationName",
    );
    const modalDeclarationDesignation = document.getElementById(
      "modalDeclarationDesignation",
    );
    const modalFinancialYear = document.getElementById("modalFinancialYear");
    const modalOperations = document.getElementById("modalOperations");
    const modalRoi = document.getElementById("modalRoi");
    const modalPdfLink = document.getElementById(
      "modalPdfLink",
    ) as HTMLAnchorElement | null;
    const modalReviewLink = document.getElementById(
      "modalReviewLink",
    ) as HTMLAnchorElement | null;

    function openModal(btn: HTMLElement) {
      const ref = btn.getAttribute("data-reference") || "";
      const company = btn.getAttribute("data-company") || "";
      const fy = btn.getAttribute("data-financial-year") || "2025/26";
      const ops = btn.getAttribute("data-operations") || "N/A";
      const cName = btn.getAttribute("data-contact-name") || "N/A";
      const cDesig = btn.getAttribute("data-contact-designation") || "N/A";
      const cEmail = btn.getAttribute("data-contact-email") || "N/A";
      const cPhone = btn.getAttribute("data-contact-phone") || "N/A";
      const dName = btn.getAttribute("data-declaration-name") || cName;
      const dDesig = btn.getAttribute("data-declaration-designation") || cDesig;
      const roi = btn.getAttribute("data-roi") || "0.00";
      const status = btn.getAttribute("data-status") || "PENDING";
      const submitted = btn.getAttribute("data-submitted") || "";

      if (modalReference) modalReference.textContent = ref;
      if (modalCompany) modalCompany.textContent = company;
      if (modalSubmitted) modalSubmitted.textContent = submitted;
      if (modalContactName) modalContactName.textContent = cName;
      if (modalContactDesignation) modalContactDesignation.textContent = cDesig;
      if (modalContactEmail) modalContactEmail.textContent = cEmail;
      if (modalContactPhone) modalContactPhone.textContent = cPhone;
      if (modalDeclarationName) modalDeclarationName.textContent = dName;
      if (modalDeclarationDesignation)
        modalDeclarationDesignation.textContent = dDesig;
      if (modalFinancialYear) modalFinancialYear.textContent = fy;
      if (modalOperations) modalOperations.textContent = ops;
      if (modalRoi) modalRoi.textContent = `${roi}%`;
      if (modalStatus) modalStatus.textContent = status;

      if (modalPdfLink)
        modalPdfLink.href = `/api/admin/download-file?ref=${ref}&type=pdf`;
      if (modalReviewLink) modalReviewLink.href = `/admin/applications/${ref}`;

      if (detailModal) {
        detailModal.classList.remove("hidden");
        document.body.classList.add("overflow-hidden");
      }
    }

    function closeModal() {
      if (detailModal) {
        detailModal.classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
      }
    }

    // Delete Confirmation Modal Management
    const deleteConfirmModal = document.getElementById("deleteConfirmModal");
    const deleteModalBackdrop = document.getElementById("deleteModalBackdrop");
    const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");
    const confirmDeleteBtn = document.getElementById(
      "confirmDeleteBtn",
    ) as HTMLButtonElement | null;
    const confirmDeleteBtnText = document.getElementById(
      "confirmDeleteBtnText",
    );
    const deleteModalRef = document.getElementById("deleteModalRef");

    let appToDeleteId: string | null = null;
    let appToDeleteRef: string | null = null;
    let appToDeleteRow: HTMLTableRowElement | null = null;

    function openDeleteModal(
      id: string,
      ref: string,
      row: HTMLTableRowElement | null,
    ) {
      appToDeleteId = id;
      appToDeleteRef = ref;
      appToDeleteRow = row;

      if (deleteModalRef) {
        deleteModalRef.textContent = ref;
      }
      if (deleteConfirmModal) {
        deleteConfirmModal.classList.remove("hidden");
        document.body.classList.add("overflow-hidden");
      }
    }

    function closeDeleteModal() {
      if (deleteConfirmModal) {
        deleteConfirmModal.classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
      }
      appToDeleteId = null;
      appToDeleteRef = null;
      appToDeleteRow = null;
      if (confirmDeleteBtn) confirmDeleteBtn.disabled = false;
      if (confirmDeleteBtnText)
        confirmDeleteBtnText.textContent = "Confirm Delete";
    }

    cancelDeleteBtn?.addEventListener("click", closeDeleteModal);
    deleteModalBackdrop?.addEventListener("click", closeDeleteModal);

    // Execute application deletion upon confirmation
    confirmDeleteBtn?.addEventListener("click", async () => {
      if (!appToDeleteId) return;

      const targetId = appToDeleteId;
      const targetRef = appToDeleteRef || targetId;
      const targetRow = appToDeleteRow;

      if (confirmDeleteBtn) confirmDeleteBtn.disabled = true;
      if (confirmDeleteBtnText)
        confirmDeleteBtnText.textContent = "Deleting...";

      try {
        const response = await fetch(
          `/api/admin/applications/${encodeURIComponent(targetId)}`,
          {
            method: "DELETE",
            headers: {
              "Content-Type": "application/json",
            },
          },
        );

        const data = await response.json();

        if (response.ok && data.success) {
          closeDeleteModal();

          // Animate and remove deleted row from dashboard UI table without full reload
          if (targetRow) {
            targetRow.style.transition =
              "all 0.35s cubic-bezier(0.4, 0, 0.2, 1)";
            targetRow.style.opacity = "0";
            targetRow.style.transform = "translateX(24px)";
            targetRow.style.pointerEvents = "none";

            setTimeout(() => {
              targetRow.remove();
              applyFilter();
            }, 350);
          }

          showToast(
            "Application Deleted",
            data.message || `Application ${targetRef} was permanently deleted.`,
          );
        } else {
          alert(
            data.message || "Failed to delete application. Please try again.",
          );
          if (confirmDeleteBtn) confirmDeleteBtn.disabled = false;
          if (confirmDeleteBtnText)
            confirmDeleteBtnText.textContent = "Confirm Delete";
        }
      } catch (err) {
        console.error("[Delete Application Error]", err);
        alert(
          "An unexpected network or server error occurred while deleting the application.",
        );
        if (confirmDeleteBtn) confirmDeleteBtn.disabled = false;
        if (confirmDeleteBtnText)
          confirmDeleteBtnText.textContent = "Confirm Delete";
      }
    });

    // Clickable table rows navigation
    document
      .querySelectorAll<HTMLTableRowElement>(".application-row")
      .forEach((row) => {
        // Mouse click navigation
        row.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (target.closest("button") || target.closest("a")) {
            return;
          }
          const href = row.getAttribute("data-href");
          if (href) {
            window.location.href = href;
          }
        });

        // Keyboard navigation (Enter key)
        row.addEventListener("keydown", (e: KeyboardEvent) => {
          if (e.key === "Enter") {
            const target = e.target as HTMLElement;
            if (target.closest("button") || target.closest("a")) {
              return;
            }
            const href = row.getAttribute("data-href");
            if (href) {
              window.location.href = href;
            }
          }
        });
      });

    // Quick View button with event propagation stop
    document
      .querySelectorAll<HTMLButtonElement>(".quick-view-btn")
      .forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          openModal(btn);
        });
      });

    // Delete button with event propagation stop & modal trigger
    document
      .querySelectorAll<HTMLButtonElement>(".delete-app-btn")
      .forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const id = btn.getAttribute("data-id") || "";
          const ref = btn.getAttribute("data-reference") || "";
          const row = btn.closest<HTMLTableRowElement>(".application-row");
          openDeleteModal(id, ref, row);
        });
      });

    // Explicit links inside table rows
    document
      .querySelectorAll<HTMLAnchorElement>(".application-row a")
      .forEach((link) => {
        link.addEventListener("click", (e) => {
          e.stopPropagation();
        });
      });

    closeModalBtn?.addEventListener("click", closeModal);
    modalBackdrop?.addEventListener("click", closeModal);

    // Notification Settings Modal Management
    const openSettingsBtn = document.getElementById("openSettingsBtn");
    const settingsModal = document.getElementById("settingsModal");
    const settingsModalBackdrop = document.getElementById(
      "settingsModalBackdrop",
    );
    const closeSettingsBtn = document.getElementById("closeSettingsBtn");
    const cancelSettingsBtn = document.getElementById("cancelSettingsBtn");
    const saveSettingsBtn = document.getElementById(
      "saveSettingsBtn",
    ) as HTMLButtonElement | null;
    const saveSettingsBtnText = document.getElementById("saveSettingsBtnText");
    const adminEmailInput = document.getElementById(
      "adminEmailInput",
    ) as HTMLInputElement | null;
    const settingsErrorMsg = document.getElementById("settingsErrorMsg");

    function openSettingsModal() {
      if (!settingsModal) return;
      settingsModal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      if (settingsErrorMsg) {
        settingsErrorMsg.textContent = "";
        settingsErrorMsg.classList.add("hidden");
      }
      // Fetch latest email from API
      fetch("/api/admin/settings")
        .then((res) => res.json())
        .then((data) => {
          if (data?.success && data.email && adminEmailInput) {
            adminEmailInput.value = data.email;
          }
        })
        .catch(() => {});
    }

    function closeSettingsModal() {
      if (!settingsModal) return;
      settingsModal.classList.add("hidden");
      document.body.style.overflow = "";
    }

    openSettingsBtn?.addEventListener("click", openSettingsModal);
    closeSettingsBtn?.addEventListener("click", closeSettingsModal);
    cancelSettingsBtn?.addEventListener("click", closeSettingsModal);
    settingsModalBackdrop?.addEventListener("click", closeSettingsModal);

    saveSettingsBtn?.addEventListener("click", async () => {
      const email = adminEmailInput?.value.trim() ?? "";
      if (!email) {
        if (settingsErrorMsg) {
          settingsErrorMsg.textContent = "Please enter an email address.";
          settingsErrorMsg.classList.remove("hidden");
        }
        return;
      }

      if (saveSettingsBtn) saveSettingsBtn.disabled = true;
      if (saveSettingsBtnText) saveSettingsBtnText.textContent = "Saving...";
      if (settingsErrorMsg) settingsErrorMsg.classList.add("hidden");

      try {
        const response = await fetch("/api/admin/settings", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ admin_notification_email: email }),
        });
        const result = await response.json();

        if (response.ok && result.success) {
          closeSettingsModal();
          showToast(
            "Notification Settings Saved",
            "Admin notification email updated to: " + (result.email || email),
          );
        } else {
          if (settingsErrorMsg) {
            settingsErrorMsg.textContent =
              result.message || "Failed to update notification email.";
            settingsErrorMsg.classList.remove("hidden");
          }
        }
      } catch (err) {
        if (settingsErrorMsg) {
          settingsErrorMsg.textContent = "Network error while saving settings.";
          settingsErrorMsg.classList.remove("hidden");
        }
      } finally {
        if (saveSettingsBtn) saveSettingsBtn.disabled = false;
        if (saveSettingsBtnText) saveSettingsBtnText.textContent = "Save Email";
      }
    });

    // Global keyboard listener for Escape key to close any active modal
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (settingsModal && !settingsModal.classList.contains("hidden")) {
          closeSettingsModal();
        } else if (
          deleteConfirmModal &&
          !deleteConfirmModal.classList.contains("hidden")
        ) {
          closeDeleteModal();
        } else if (detailModal && !detailModal.classList.contains("hidden")) {
          closeModal();
        }
      }
    });
  </script>
</AdminLayout>
