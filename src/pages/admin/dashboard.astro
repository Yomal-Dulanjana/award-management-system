---
// src/pages/admin/dashboard.astro — Administrator Applications Overview
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db, initDb } from "@/db";
import { applications } from "@/db/schema";
import { desc } from "drizzle-orm";

export const prerender = false;

await initDb();

// Fetch all applications ordered by newest submission first
const allApplications = await db
  .select()
  .from(applications)
  .orderBy(desc(applications.submitted_at));

// Compute overview metrics
const totalCount = allApplications.length;
const pendingCount = allApplications.filter(
  (a) => a.status === "PENDING",
).length;
const underReviewCount = allApplications.filter(
  (a) => a.status === "UNDER_REVIEW",
).length;
const approvedCount = allApplications.filter(
  (a) => a.status === "APPROVED",
).length;
const rejectedCount = allApplications.filter(
  (a) => a.status === "REJECTED",
).length;

// Currency / Date helpers
const fmtDate = (d: Date | string) => {
  const date = new Date(d);
  return date.toLocaleDateString("en-LK", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
};
---

<AdminLayout
  title="Applications Dashboard | Best Diversified Company Award"
  activeNav="dashboard"
>
  <div class="space-y-8">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Applications Dashboard
        </h1>
        <p class="mt-1 text-sm text-slate-400">
          Review, evaluate, and track candidate submissions for the 2025/26
          Diversification Award.
        </p>
      </div>
      <div class="flex items-center space-x-3">
        <a
          href="/admin/dashboard"
          class="inline-flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold border border-slate-700 transition-colors"
        >
          <svg
            class="w-4 h-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            />
          </svg>
          <span>Refresh Data</span>
        </a>
      </div>
    </div>

    <!-- Overview Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <!-- Total Applications -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-slate-700 transition-all">
        <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/5 rounded-full blur-2xl pointer-events-none"></div>
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
            Total Submissions
          </span>
          <div class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
          </div>
        </div>
        <div class="mt-4 flex items-baseline space-x-2">
          <span class="text-3xl font-extrabold text-white tracking-tight">
            {totalCount}
          </span>
          <span class="text-xs text-slate-400">Registered</span>
        </div>
      </div>

      <!-- Pending Reviews -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-amber-500/30 transition-all">
        <div class="absolute top-0 right-0 w-24 h-24 bg-amber-500/5 rounded-full blur-2xl pointer-events-none"></div>
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
            Pending Review
          </span>
          <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
        </div>
        <div class="mt-4 flex items-baseline space-x-2">
          <span class="text-3xl font-extrabold text-amber-400 tracking-tight">
            {pendingCount}
          </span>
          <span class="text-xs text-slate-400">Awaiting Action</span>
        </div>
      </div>

      <!-- Under Review -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-indigo-500/30 transition-all">
        <div class="absolute top-0 right-0 w-24 h-24 bg-indigo-500/5 rounded-full blur-2xl pointer-events-none"></div>
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
            Under Review
          </span>
          <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              />
            </svg>
          </div>
        </div>
        <div class="mt-4 flex items-baseline space-x-2">
          <span class="text-3xl font-extrabold text-indigo-400 tracking-tight">
            {underReviewCount}
          </span>
          <span class="text-xs text-slate-400">In Evaluation</span>
        </div>
      </div>

      <!-- Approved Candidates -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-emerald-500/30 transition-all">
        <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/5 rounded-full blur-2xl pointer-events-none"></div>
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
            Approved Candidates
          </span>
          <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
        </div>
        <div class="mt-4 flex items-baseline space-x-2">
          <span class="text-3xl font-extrabold text-emerald-400 tracking-tight">
            {approvedCount}
          </span>
          <span class="text-xs text-slate-400">Qualified</span>
        </div>
      </div>
    </div>

    <!-- Submissions Table Section -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden">
      <!-- Search & Filters Toolbar -->
      <div class="p-4 sm:p-6 border-b border-slate-800 flex flex-col md:flex-row gap-4 items-stretch md:items-center justify-between">
        <div class="relative flex-1 max-w-md">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          </div>
          <input
            id="searchInput"
            type="text"
            placeholder="Search by Reference No, Company Name, or Contact..."
            class="block w-full pl-10 pr-4 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all"
          />
        </div>

        <div class="flex items-center space-x-3">
          <label
            for="statusFilter"
            class="text-xs font-semibold uppercase tracking-wider text-slate-400"
          >
            Status:
          </label>
          <select
            id="statusFilter"
            class="bg-slate-950/80 border border-slate-800 rounded-xl px-3.5 py-2.5 text-sm text-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all"
          >
            <option value="ALL">All Submissions ({totalCount})</option>
            <option value="PENDING">Pending ({pendingCount})</option>
            <option value="UNDER_REVIEW">
              Under Review ({underReviewCount})
            </option>
            <option value="APPROVED">Approved ({approvedCount})</option>
            <option value="REJECTED">Rejected ({rejectedCount})</option>
          </select>
        </div>
      </div>

      <!-- Responsive Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-950/60 text-xs uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
            <tr>
              <th scope="col" class="px-6 py-4">
                Reference No
              </th>
              <th scope="col" class="px-6 py-4">
                Company Name
              </th>
              <th scope="col" class="px-6 py-4">
                Contact Name
              </th>
              <th scope="col" class="px-6 py-4">
                Designation
              </th>
              <th scope="col" class="px-6 py-4 text-right">
                ROI %
              </th>
              <th scope="col" class="px-6 py-4">
                Submitted Date
              </th>
              <th scope="col" class="px-6 py-4 text-center">
                Status
              </th>
              <th scope="col" class="px-6 py-4 text-right">
                Action
              </th>
            </tr>
          </thead>
          <tbody
            id="applicationsTableBody"
            class="divide-y divide-slate-800/80 font-normal"
          >
            {allApplications.length === 0 ? (
              <tr>
                <td colspan="8" class="px-6 py-12 text-center text-slate-400">
                  <div class="flex flex-col items-center justify-center">
                    <svg
                      class="w-12 h-12 text-slate-600 mb-3"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      />
                    </svg>
                    <p class="text-base font-semibold text-slate-300">
                      No applications submitted yet
                    </p>
                    <p class="text-xs text-slate-400 mt-1">
                      Applications submitted via the public form will appear
                      here in real-time.
                    </p>
                  </div>
                </td>
              </tr>
            ) : (
              allApplications.map((app) => (
                <tr
                  class="application-row hover:bg-slate-800/40 transition-colors"
                  data-reference={app.reference.toLowerCase()}
                  data-company={app.company_name.toLowerCase()}
                  data-contact={app.contact_name.toLowerCase()}
                  data-designation={(app.contact_designation || (app.data_json as any)?.contact_designation || "").toLowerCase()}
                  data-email={app.contact_email.toLowerCase()}
                  data-status={app.status}
                >
                  <!-- Reference No -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-slate-800 border border-slate-700 text-amber-400 tracking-wide">
                      {app.reference}
                    </span>
                  </td>

                  <!-- Company Name -->
                  <td class="px-6 py-4 font-semibold text-white whitespace-nowrap">
                    <a
                      href={`/admin/applications/${app.reference}`}
                      class="hover:text-amber-400 transition-colors"
                    >
                      {app.company_name}
                    </a>
                  </td>

                  <!-- Contact Name -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-white text-xs font-medium">
                      {app.contact_name}
                    </div>
                    <div class="text-slate-400 text-xs font-mono mt-0.5">
                      {app.contact_email}
                    </div>
                  </td>

                  <!-- Designation -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-slate-800/90 text-slate-300 border border-slate-700/80">
                      {app.contact_designation || (app.data_json as any)?.contact_designation || "—"}
                    </span>
                  </td>

                  <!-- ROI % -->
                  <td class="px-6 py-4 whitespace-nowrap text-right font-mono font-bold">
                    <span
                      class={
                        Number(app.roi_percent) >= 20
                          ? "text-emerald-400"
                          : "text-slate-200"
                      }
                    >
                      {Number(app.roi_percent).toFixed(2)}%
                    </span>
                  </td>

                  <!-- Submitted Date -->
                  <td class="px-6 py-4 whitespace-nowrap text-slate-400 text-xs font-mono">
                    {fmtDate(app.submitted_at)}
                  </td>

                  <!-- Status Pill -->
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    {app.status === "PENDING" && (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 mr-1.5 animate-pulse"></span>
                        Pending
                      </span>
                    )}
                    {app.status === "UNDER_REVIEW" && (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/30">
                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 mr-1.5"></span>
                        Under Review
                      </span>
                    )}
                    {app.status === "APPROVED" && (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5"></span>
                        Approved
                      </span>
                    )}
                    {app.status === "REJECTED" && (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/30">
                        <span class="w-1.5 h-1.5 rounded-full bg-rose-400 mr-1.5"></span>
                        Rejected
                      </span>
                    )}
                  </td>

                  <!-- Action -->
                  <td class="px-6 py-4 whitespace-nowrap text-right text-xs">
                    <div class="inline-flex items-center space-x-2">
                      <button
                        type="button"
                        class="quick-view-btn inline-flex items-center space-x-1 px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold transition-all hover:scale-[1.02]"
                        data-reference={app.reference}
                        data-company={app.company_name}
                        data-financial-year={app.financial_year}
                        data-operations={app.nature_of_operations}
                        data-contact-name={app.contact_name}
                        data-contact-designation={app.contact_designation || (app.data_json as any)?.contact_designation || "—"}
                        data-contact-email={app.contact_email}
                        data-contact-phone={app.contact_phone}
                        data-declaration-name={app.declaration_name || (app.data_json as any)?.declaration_name || app.contact_name}
                        data-declaration-designation={app.declaration_designation || (app.data_json as any)?.declaration_designation || app.contact_designation || "Authorized Representative"}
                        data-roi={Number(app.roi_percent).toFixed(2)}
                        data-status={app.status}
                        data-submitted={fmtDate(app.submitted_at)}
                      >
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        <span>Quick View</span>
                      </button>

                      <a
                        href={`/admin/applications/${app.reference}`}
                        class="inline-flex items-center space-x-1 px-3 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-semibold transition-all hover:scale-[1.02]"
                      >
                        <span>Review</span>
                        <svg
                          class="w-3.5 h-3.5"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                          />
                        </svg>
                      </a>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <!-- No Results from Search Filter -->
      <div
        id="noMatchMessage"
        class="hidden px-6 py-12 text-center text-slate-400 border-t border-slate-800"
      >
        <p class="text-sm font-semibold text-slate-300">
          No matching submissions found
        </p>
        <p class="text-xs text-slate-400 mt-1">
          Try refining your search keyword or changing the status filter.
        </p>
      </div>

      <!-- Footer count info -->
      <div class="p-4 bg-slate-950/60 border-t border-slate-800 text-xs text-slate-400 flex justify-between items-center">
        <span id="showingCount">
          Showing {totalCount} of {totalCount} submissions
        </span>
        <span class="font-mono text-[11px] text-slate-400">
          Database Engine: MySQL
        </span>
      </div>
    </div>
  </div>

  <!-- Single Application Detail Modal -->
  <div
    id="detailModal"
    class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 overflow-y-auto"
    aria-labelledby="modalTitle"
    role="dialog"
    aria-modal="true"
  >
    <!-- Modal Backdrop -->
    <div id="modalBackdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm transition-opacity"></div>

    <!-- Modal Card -->
    <div class="relative bg-slate-900 border border-slate-800 rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl z-10 space-y-6 max-h-[90vh] overflow-y-auto">
      <!-- Modal Header -->
      <div class="flex items-start justify-between border-b border-slate-800 pb-5">
        <div>
          <div class="flex items-center gap-2.5">
            <span
              id="modalReference"
              class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-slate-800 border border-slate-700 text-amber-400 tracking-wide"
            >
              BDC-2026-REF
            </span>
            <span
              id="modalStatus"
              class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30"
            >
              Pending
            </span>
          </div>
          <h3 id="modalCompany" class="text-xl font-bold text-white mt-2">
            Company Name
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">
            Submitted: <span id="modalSubmitted" class="font-mono text-slate-300"></span>
          </p>
        </div>

        <button
          type="button"
          id="closeModalBtn"
          class="p-2 text-slate-400 hover:text-white rounded-xl bg-slate-800/80 hover:bg-slate-800 transition-colors"
          aria-label="Close modal"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Section: Designated Contact Person (Strictly Separate Fields) -->
      <div class="bg-slate-950/60 border border-slate-800/80 rounded-2xl p-5 space-y-3">
        <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>Designated Contact Person</span>
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs pt-1">
          <div>
            <span class="text-slate-400 uppercase tracking-wider block text-[11px]">Contact Name</span>
            <span id="modalContactName" class="font-semibold text-white mt-1 block text-sm"></span>
          </div>
          <div>
            <span class="text-slate-400 uppercase tracking-wider block text-[11px]">Designation</span>
            <span id="modalContactDesignation" class="font-semibold text-slate-200 mt-1 block text-sm"></span>
          </div>
          <div>
            <span class="text-slate-400 uppercase tracking-wider block text-[11px]">Email Address</span>
            <span id="modalContactEmail" class="font-mono text-amber-400 mt-1 block"></span>
          </div>
          <div>
            <span class="text-slate-400 uppercase tracking-wider block text-[11px]">Telephone</span>
            <span id="modalContactPhone" class="font-mono text-slate-200 mt-1 block"></span>
          </div>
        </div>
      </div>

      <!-- Section: Authorized Declaration Signatory (Strictly Separate Fields) -->
      <div class="bg-slate-950/60 border border-slate-800/80 rounded-2xl p-5 space-y-3">
        <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Authorized Declaration Signatory</span>
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs pt-1">
          <div>
            <span class="text-slate-400 uppercase tracking-wider block text-[11px]">Name of Authorized Person</span>
            <span id="modalDeclarationName" class="font-semibold text-white mt-1 block text-sm"></span>
          </div>
          <div>
            <span class="text-slate-400 uppercase tracking-wider block text-[11px]">Designation / Title</span>
            <span id="modalDeclarationDesignation" class="font-semibold text-slate-200 mt-1 block text-sm"></span>
          </div>
        </div>
      </div>

      <!-- Section: Evaluation Context -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <div class="bg-slate-950/40 border border-slate-800 p-3.5 rounded-xl">
          <span class="text-slate-400 block text-[11px]">Evaluation Year</span>
          <span id="modalFinancialYear" class="font-mono font-bold text-white mt-1 block"></span>
        </div>
        <div class="bg-slate-950/40 border border-slate-800 p-3.5 rounded-xl">
          <span class="text-slate-400 block text-[11px]">Nature of Operations</span>
          <span id="modalOperations" class="font-semibold text-white mt-1 block"></span>
        </div>
        <div class="bg-slate-950/40 border border-slate-800 p-3.5 rounded-xl">
          <span class="text-slate-400 block text-[11px]">Return on Investment</span>
          <span id="modalRoi" class="font-mono font-bold text-emerald-400 mt-1 block"></span>
        </div>
      </div>

      <!-- Modal Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-4 border-t border-slate-800">
        <a
          id="modalPdfLink"
          href="#"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-semibold transition-colors"
        >
          <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download PDF</span>
        </a>

        <a
          id="modalReviewLink"
          href="#"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all"
        >
          <span>Open Full Dossier Review</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Client-side real-time Search, Filter & Quick View Script -->
  <script>
    const searchInput = document.getElementById(
      "searchInput",
    ) as HTMLInputElement | null;
    const statusFilter = document.getElementById(
      "statusFilter",
    ) as HTMLSelectElement | null;
    const rows =
      document.querySelectorAll<HTMLTableRowElement>(".application-row");
    const noMatchMessage = document.getElementById("noMatchMessage");
    const showingCount = document.getElementById("showingCount");
    const totalRows = rows.length;

    function applyFilter() {
      const query = (searchInput?.value ?? "").toLowerCase().trim();
      const selectedStatus = (statusFilter?.value ?? "ALL").toUpperCase();

      let visibleCount = 0;

      rows.forEach((row) => {
        const ref = row.getAttribute("data-reference") ?? "";
        const company = row.getAttribute("data-company") ?? "";
        const contact = row.getAttribute("data-contact") ?? "";
        const designation = row.getAttribute("data-designation") ?? "";
        const email = row.getAttribute("data-email") ?? "";
        const status = row.getAttribute("data-status") ?? "";

        const matchesQuery =
          !query ||
          ref.includes(query) ||
          company.includes(query) ||
          contact.includes(query) ||
          designation.includes(query) ||
          email.includes(query);
        const matchesStatus =
          selectedStatus === "ALL" || status === selectedStatus;

        if (matchesQuery && matchesStatus) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      });

      if (noMatchMessage) {
        if (visibleCount === 0 && totalRows > 0) {
          noMatchMessage.classList.remove("hidden");
        } else {
          noMatchMessage.classList.add("hidden");
        }
      }

      if (showingCount) {
        showingCount.textContent = `Showing ${visibleCount} of ${totalRows} submissions`;
      }
    }

    searchInput?.addEventListener("input", applyFilter);
    statusFilter?.addEventListener("change", applyFilter);

    // Quick View Modal Management
    const detailModal = document.getElementById("detailModal");
    const modalBackdrop = document.getElementById("modalBackdrop");
    const closeModalBtn = document.getElementById("closeModalBtn");

    const modalReference = document.getElementById("modalReference");
    const modalStatus = document.getElementById("modalStatus");
    const modalCompany = document.getElementById("modalCompany");
    const modalSubmitted = document.getElementById("modalSubmitted");
    const modalContactName = document.getElementById("modalContactName");
    const modalContactDesignation = document.getElementById("modalContactDesignation");
    const modalContactEmail = document.getElementById("modalContactEmail");
    const modalContactPhone = document.getElementById("modalContactPhone");
    const modalDeclarationName = document.getElementById("modalDeclarationName");
    const modalDeclarationDesignation = document.getElementById("modalDeclarationDesignation");
    const modalFinancialYear = document.getElementById("modalFinancialYear");
    const modalOperations = document.getElementById("modalOperations");
    const modalRoi = document.getElementById("modalRoi");
    const modalPdfLink = document.getElementById("modalPdfLink") as HTMLAnchorElement | null;
    const modalReviewLink = document.getElementById("modalReviewLink") as HTMLAnchorElement | null;

    function openModal(btn: HTMLElement) {
      const ref = btn.getAttribute("data-reference") || "";
      const company = btn.getAttribute("data-company") || "";
      const fy = btn.getAttribute("data-financial-year") || "2025/26";
      const ops = btn.getAttribute("data-operations") || "N/A";
      const cName = btn.getAttribute("data-contact-name") || "N/A";
      const cDesig = btn.getAttribute("data-contact-designation") || "N/A";
      const cEmail = btn.getAttribute("data-contact-email") || "N/A";
      const cPhone = btn.getAttribute("data-contact-phone") || "N/A";
      const dName = btn.getAttribute("data-declaration-name") || cName;
      const dDesig = btn.getAttribute("data-declaration-designation") || cDesig;
      const roi = btn.getAttribute("data-roi") || "0.00";
      const status = btn.getAttribute("data-status") || "PENDING";
      const submitted = btn.getAttribute("data-submitted") || "";

      if (modalReference) modalReference.textContent = ref;
      if (modalCompany) modalCompany.textContent = company;
      if (modalSubmitted) modalSubmitted.textContent = submitted;
      if (modalContactName) modalContactName.textContent = cName;
      if (modalContactDesignation) modalContactDesignation.textContent = cDesig;
      if (modalContactEmail) modalContactEmail.textContent = cEmail;
      if (modalContactPhone) modalContactPhone.textContent = cPhone;
      if (modalDeclarationName) modalDeclarationName.textContent = dName;
      if (modalDeclarationDesignation) modalDeclarationDesignation.textContent = dDesig;
      if (modalFinancialYear) modalFinancialYear.textContent = fy;
      if (modalOperations) modalOperations.textContent = ops;
      if (modalRoi) modalRoi.textContent = `${roi}%`;
      if (modalStatus) modalStatus.textContent = status;

      if (modalPdfLink) modalPdfLink.href = `/api/admin/download-file?ref=${ref}&type=pdf`;
      if (modalReviewLink) modalReviewLink.href = `/admin/applications/${ref}`;

      if (detailModal) {
        detailModal.classList.remove("hidden");
        document.body.classList.add("overflow-hidden");
      }
    }

    function closeModal() {
      if (detailModal) {
        detailModal.classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
      }
    }

    document.querySelectorAll<HTMLButtonElement>(".quick-view-btn").forEach((btn) => {
      btn.addEventListener("click", () => openModal(btn));
    });

    closeModalBtn?.addEventListener("click", closeModal);
    modalBackdrop?.addEventListener("click", closeModal);
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && detailModal && !detailModal.classList.contains("hidden")) {
        closeModal();
      }
    });
  </script>
</AdminLayout>
