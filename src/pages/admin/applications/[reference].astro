---
// Comprehensive application review
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getApplicationByReference } from "@/lib/applications";
import {
  fmtCurrency,
  fmtDate,
  fmtFileSize as fmtBytes,
  formatSLDateTime,
} from "@/utils/formatters";

export const prerender = false;

const { reference } = Astro.params;
if (!reference) {
  return Astro.redirect("/admin/dashboard");
}

const appData = await getApplicationByReference(reference);
if (!appData) {
  return Astro.redirect("/admin/dashboard");
}

const { application: app, attachments, formData } = appData;
const title = `${app.company_name} (${app.reference}) | Admin Review`;
---

<AdminLayout title={title} activeNav="applications">
  <div class="space-y-8 max-w-6xl mx-auto">
    <!-- Breadcrumb & Back Action -->
    <div class="flex items-center justify-between">
      <nav class="flex items-center space-x-2 text-xs text-slate-400 font-medium">
        <a
          href="/admin/dashboard"
          class="hover:text-amber-400 transition-colors flex items-center space-x-1"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            />
          </svg>
          <span>Back to Dashboard</span>
        </a>
        <span>/</span>
        <span class="text-slate-300 font-mono">{app.reference}</span>
      </nav>

      <div class="flex items-center space-x-2">
        <span class="text-xs text-slate-400">Submission Date & Time:</span>
        {(() => {
          const { dateStr, timeStr } = formatSLDateTime(app.submitted_at);
          return (
            <span class="text-xs font-mono text-slate-200">
              {dateStr} • {timeStr}
            </span>
          );
        })()}
      </div>
    </div>

    <!-- Executive Dossier Header Card -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
      <div class="absolute top-0 right-0 w-80 h-80 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 relative z-10">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">
              {app.reference}
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700">
              FY {app.financial_year}
            </span>
          </div>
          <h1 class="mt-3 text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
            {app.company_name}
          </h1>
          <p class="mt-1 text-sm text-slate-400">
            Official candidate dossier for Best Diversified Company Award
            2025/26
          </p>
        </div>

        <!-- Direct Actions & Status Transition Control -->
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
          <!-- Status Dropdown Form -->
          <div class="w-full sm:w-auto bg-slate-950/80 p-2 rounded-2xl border border-slate-800 flex items-center justify-between sm:justify-start space-x-2 min-h-[44px]">
            <label
              for="statusSelect"
              class="text-xs font-semibold uppercase tracking-wider text-slate-400 px-2 shrink-0"
            >
              Status:
            </label>
            <select
              id="statusSelect"
              data-ref={app.reference}
              class="bg-slate-900 border border-slate-700 text-white rounded-xl px-3 py-1.5 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all cursor-pointer min-h-[36px]"
            >
              <option value="PENDING" selected={app.status === "PENDING"}>
                PENDING
              </option>
              <option
                value="UNDER_REVIEW"
                selected={app.status === "UNDER_REVIEW"}
              >
                UNDER REVIEW
              </option>
              <option value="APPROVED" selected={app.status === "APPROVED"}>
                APPROVED
              </option>
              <option value="REJECTED" selected={app.status === "REJECTED"}>
                REJECTED
              </option>
            </select>
            <span
              id="statusToast"
              class="hidden text-xs text-emerald-400 font-semibold px-2 animate-fade-in"
            >
              Saved!
            </span>
          </div>

          <!-- Download Application PDF -->
          <a
            href={`/api/admin/download-file?ref=${app.reference}&type=pdf`}
            target="_blank"
            class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all hover:scale-[1.02] min-h-[44px]"
          >
            <svg
              class="w-4 h-4 text-slate-950 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
            <span>Download Official PDF</span>
          </a>

          <!-- Download All as ZIP -->
          {attachments.length > 0 && (
            <a
              href={`/api/admin/download-file?ref=${app.reference}&type=zip`}
              class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs border border-slate-700 transition-all min-h-[44px]"
            >
              <svg
                class="w-4 h-4 text-amber-400 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"
                />
              </svg>
              <span>Download Evidence (ZIP)</span>
            </a>
          )}

          <!-- Delete Application Action -->
          <button
            type="button"
            id="detailDeleteBtn"
            class="w-full sm:w-auto inline-flex items-center justify-center space-x-1.5 px-3.5 py-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 font-semibold text-xs border border-rose-500/30 transition-all hover:scale-[1.02] min-h-[44px]"
            data-id={app.id}
            data-reference={app.reference}
            title={`Delete application ${app.reference}`}
          >
            <svg
              class="w-4 h-4 text-rose-400 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
              />
            </svg>
            <span>Delete</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Financial Performance Highlights -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-lg">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Total Company Revenue
        </span>
        <div class="mt-2 text-xl sm:text-2xl font-bold text-white font-mono break-words">
          {fmtCurrency(app.total_revenue)}
        </div>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-lg">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Diversification Revenue
        </span>
        <div class="mt-2 text-xl sm:text-2xl font-bold text-amber-400 font-mono break-words">
          {fmtCurrency(app.diversification_revenue)}
        </div>
        <div class="mt-1 text-xs text-slate-400">
          {formData.metrics?.combinedPercent ??
            (
              (Number(app.diversification_revenue) /
                (Number(app.total_revenue) || 1)) *
              100
            ).toFixed(1)}
          % of total turnover
        </div>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-lg">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Return on Investment (ROI)
        </span>
        <div class="mt-2 text-xl sm:text-2xl font-bold text-emerald-400 font-mono break-words">
          {Number(app.roi_percent).toFixed(2)}%
        </div>
        <div class="mt-1 text-xs text-slate-400">
          Profit: {fmtCurrency(app.operating_profit)}
        </div>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-lg">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Payback Period
        </span>
        <div class="mt-2 text-xl sm:text-2xl font-bold text-slate-100 font-mono break-words">
          {app.payback_years !== null
            ? `${Number(app.payback_years).toFixed(2)} Years`
            : "N/A"}
        </div>
        <div class="mt-1 text-xs text-slate-400">
          Investment: {fmtCurrency(app.total_investment)}
        </div>
      </div>
    </div>

    <!-- Structured 2-Column Dossier Body -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: Core Dossier Form Steps (2 spans) -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Step 1: Organization Profile -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
          <h2 class="text-base font-bold text-white flex items-center space-x-2 border-b border-slate-800 pb-3 mb-4">
            <span>Company Details & Name</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <span class="text-xs text-slate-400 uppercase tracking-wider block">
                Company Name
              </span>
              <span class="font-semibold text-white mt-1 block">
                {app.company_name}
              </span>
            </div>
            <div>
              <span class="text-xs text-slate-400 uppercase tracking-wider block">
                Financial Evaluation Year
              </span>
              <span class="font-semibold text-white mt-1 block font-mono">
                {app.financial_year}
              </span>
            </div>
            <div>
              <span class="text-xs text-slate-400 uppercase tracking-wider block">
                Contact Name
              </span>
              <span class="font-semibold text-white mt-1 block">
                {app.contact_name}
              </span>
            </div>
            <div>
              <span class="text-xs text-slate-400 uppercase tracking-wider block">
                Designation
              </span>
              <span class="font-semibold text-white mt-1 block">
                {app.contact_designation || formData.contact_designation || "—"}
              </span>
            </div>
            <div>
              <span class="text-xs text-slate-400 uppercase tracking-wider block">
                Contact Email
              </span>
              <a
                href={`mailto:${app.contact_email}`}
                class="font-semibold text-amber-400 hover:underline mt-1 block font-mono"
              >
                {app.contact_email}
              </a>
            </div>
            <div>
              <span class="text-xs text-slate-400 uppercase tracking-wider block">
                Telephone / Mobile
              </span>
              <span class="font-semibold text-white mt-1 block font-mono">
                {app.contact_phone}
              </span>
            </div>

            <div class="sm:col-span-2 mt-2 pt-3 border-t border-slate-800/80">
              <span class="text-xs text-slate-400 uppercase tracking-wider block">
                Nature of Operations
              </span>
              <p class="mt-1 text-slate-200 leading-relaxed text-sm bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
                {app.nature_of_operations}
              </p>
            </div>
          </div>
        </div>

        <!-- Step 2: Qualitative Criteria -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
          <h2 class="text-base font-bold text-white flex items-center space-x-2 border-b border-slate-800 pb-3 mb-4">
            <span class="w-6 h-6 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-xs font-bold">
              1
            </span>
            <span>Diversification Qualification (Mandatory)</span>
          </h2>

          <div class="space-y-4 text-sm">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800">
                <span class="text-xs text-slate-400 block">
                  New Products or Services
                </span>
                <span
                  class={`inline-block mt-1 font-bold text-xs px-2.5 py-1 rounded-md ${
                    formData.new_products_services
                      ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30"
                      : "bg-slate-800 text-slate-400"
                  }`}
                >
                  {formData.new_products_services ? "YES — Introduced" : "NO"}
                </span>
              </div>

              <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800">
                <span class="text-xs text-slate-400 block">
                  New Markets Entered
                </span>
                <span
                  class={`inline-block mt-1 font-bold text-xs px-2.5 py-1 rounded-md ${
                    formData.new_market_entered
                      ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30"
                      : "bg-slate-800 text-slate-400"
                  }`}
                >
                  {formData.new_market_entered ? "YES — Expanded" : "NO"}
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2.1: Qualitative Criteria -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
          <h2 class="text-base font-bold text-white flex items-center space-x-2 border-b border-slate-800 pb-3 mb-4">
            <span class="w-6 h-6 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-xs font-bold">
              2
            </span>
            <span>Diversification of Products/ Services</span>
          </h2>

          <div class="space-y-4 text-sm">
            <!-- Products Table -->
            {formData.products && formData.products.length > 0 && (
              <div class="mt-4">
                <span class="text-xs text-slate-400 uppercase tracking-wider block mb-2">
                  Diversification of Products/ Services (
                  {formData.products.length})
                </span>
                <div class="overflow-x-auto rounded-xl border border-slate-800">
                  <table class="w-full text-left text-xs">
                    <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
                      <tr>
                        <th class="px-4 py-2.5 w-1/3">
                          Product / Service Name
                        </th>
                        <th class="px-4 py-2.5">Description & Scope</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800 bg-slate-900/50">
                      {formData.products.map((p) => (
                        <tr>
                          <td class="px-4 py-2.5 font-semibold text-white whitespace-nowrap">
                            {p.name}
                          </td>
                          <td class="px-4 py-2.5 text-slate-300">
                            {p.description}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {formData.new_market_details && (
              <div>
                <span class="text-xs text-slate-400 uppercase tracking-wider block mb-2">
                  Diversification of Products/ Services
                </span>
                <span class="font-regular text-white mt-1 block">
                  {formData.new_market_details}
                </span>
              </div>
            )}
          </div>
        </div>

        <!-- Step 3: Revenue Diversification Activity Breakdown -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
          <h2 class="text-base font-bold text-white flex items-center space-x-2 border-b border-slate-800 pb-3 mb-4">
            <span class="w-6 h-6 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-xs font-bold">
              3
            </span>
            <span>
              Diversification Revenue Breakdown |{" "}
              {fmtCurrency(app.total_revenue)}
            </span>
          </h2>

          {formData.revenue && formData.revenue.length > 0 ? (
            <div class="overflow-x-auto rounded-xl border border-slate-800">
              <table class="w-full text-left text-xs">
                <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
                  <tr>
                    <th class="px-4 py-3">#</th>
                    <th class="px-4 py-3">Business Activity</th>
                    <th class="px-4 py-3 text-right">Revenue (LKR)</th>
                    <th class="px-4 py-3 text-right">% of total revenue</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800 bg-slate-900/50">
                  {formData.revenue.map((r, idx) => {
                    const totalRev = Number(app.total_revenue) || 1;
                    const rowRev = Number(r.revenue) || 0;
                    const pct = ((rowRev / totalRev) * 100).toFixed(1);
                    return (
                      <tr>
                        <td class="px-4 py-3 text-slate-400 font-mono">
                          {idx + 1}
                        </td>
                        <td class="px-4 py-3 font-semibold text-white">
                          {r.activity}
                        </td>
                        <td class="px-4 py-3 text-right font-mono text-slate-200">
                          {fmtCurrency(r.revenue)}
                        </td>
                        <td class="px-4 py-3 text-right font-mono text-amber-400 font-semibold">
                          {pct}%
                        </td>
                      </tr>
                    );
                  })}
                  {(() => {
                    const totalRev = Number(app.total_revenue) || 1;
                    const totalDivRev =
                      Number(app.diversification_revenue) || 0;
                    const totalPct = ((totalDivRev / totalRev) * 100).toFixed(
                      1,
                    );
                    return (
                      <tr class="bg-slate-950/80 font-bold border-t border-slate-700">
                        <td
                          colspan="2"
                          class="px-4 py-3 text-right uppercase tracking-wider text-slate-400"
                        >
                          Total Diversification:
                        </td>
                        <td class="px-4 py-3 text-right font-mono text-amber-400">
                          {fmtCurrency(app.diversification_revenue)}
                        </td>
                        <td class="px-4 py-3 text-right font-mono text-white">
                          {totalPct}%
                        </td>
                      </tr>
                    );
                  })()}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="text-xs text-slate-400">
              No individual revenue rows recorded.
            </p>
          )}
        </div>

        <!-- Step 4: Gross Profit Margin Improvement -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
          <h2 class="text-base font-bold text-white flex items-center space-x-2 border-b border-slate-800 pb-3 mb-4">
            <span class="w-6 h-6 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-xs font-bold">
              4
            </span>
            <span>Gross Profit Margin Improvement</span>
          </h2>

          <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800">
            <div>
              <span class="font-regular text-white mt-1 block">
                {formData.gross_profit_margin_option || "Not Specified"}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Evidence Attachments & Declaration Signature -->
      <div class="space-y-8">
        <!-- Supporting Evidence Files -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
            <h2 class="text-base font-bold text-white flex items-center space-x-2">
              <svg
                class="w-5 h-5 text-amber-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"
                />
              </svg>
              <span>Supporting Evidence ({attachments.length})</span>
            </h2>

            {attachments.length > 0 && (
              <a
                href={`/api/admin/download-file?ref=${app.reference}&type=zip`}
                class="text-[11px] font-bold text-amber-400 hover:text-amber-300 underline"
              >
                ZIP All
              </a>
            )}
          </div>

          {attachments.length === 0 ? (
            <div class="text-center py-6 text-slate-400 bg-slate-950/40 rounded-xl border border-slate-800/60 p-4">
              <p class="text-xs">
                No file attachments uploaded with this submission.
              </p>
            </div>
          ) : (
            <div class="space-y-3">
              {attachments.map((att) => (
                <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 flex items-center justify-between gap-3 hover:border-slate-700 transition-colors">
                  <div class="min-w-0 flex-1">
                    <p
                      class="text-xs font-semibold text-white truncate"
                      title={att.original_filename}
                    >
                      {att.original_filename}
                    </p>
                    <div class="flex items-center space-x-2 mt-1">
                      <span class="text-[10px] font-mono text-slate-400">
                        {fmtBytes(att.file_size_bytes)}
                      </span>
                      <span class="text-slate-600">•</span>
                      <span class="text-[10px] uppercase font-semibold text-amber-400/90">
                        {att.mime_type.split("/")[1] || "FILE"}
                      </span>
                    </div>
                  </div>

                  <a
                    href={`/api/admin/download-file?ref=${app.reference}&fileId=${att.id}`}
                    download={att.original_filename}
                    class="flex-shrink-0 p-2 rounded-lg bg-slate-800 hover:bg-amber-500/20 text-slate-300 hover:text-amber-400 border border-slate-700 transition-colors"
                    title={`Download ${att.original_filename}`}
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                      />
                    </svg>
                  </a>
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Official Signatory & Declaration -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
          <h2 class="text-base font-bold text-white flex items-center space-x-2 border-b border-slate-800 pb-3 mb-4">
            <svg
              class="w-5 h-5 text-amber-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              />
            </svg>
            <span>Authorized Declaration</span>
          </h2>

          <div class="space-y-3">
            <div>
              <span class="text-xs text-slate-400 tracking-wider block">
                Signatory Name
              </span>
              <span class="font-semibold text-white mt-0.5 block text-sm">
                {app.declaration_name ||
                  formData.declaration_name ||
                  app.contact_name}
              </span>
            </div>
            <div>
              <span class="text-xs text-slate-400 tracking-wider block">
                Designation / Title
              </span>
              <span class="text-sm font-semibold text-white mt-0.5 block">
                {app.declaration_designation ||
                  formData.declaration_designation ||
                  app.contact_designation ||
                  formData.contact_designation ||
                  "Authorized Representative"}
              </span>
            </div>
            <div>
              <span class="text-xs text-slate-400 tracking-wider block">
                Submited Time & Date
              </span>
              {(() => {
                const { dateStr, timeStr } = formatSLDateTime(
                  app.submitted_at || formData.declaration_date,
                );
                return (
                  <div class="flex flex-col gap-0.5 mt-1">
                    <span class="text-sm font-semibold text-white">
                      {dateStr} - {timeStr}
                    </span>
                    {/* <span class="text-xs font-normal text-white">
                      {timeStr}
                    </span> */}
                  </div>
                );
              })()}
            </div>

            <!-- Digital Signature Image Preview -->
            {formData.signature_data && (
              <div class="pt-3 border-t border-slate-800 mt-3">
                <span class="text-slate-400 uppercase tracking-wider block mb-2">
                  Digital Signature
                </span>
                <div class="bg-white rounded-xl p-3 border border-slate-700 flex items-center justify-center">
                  <img
                    src={formData.signature_data}
                    alt="Digital Signature"
                    class="max-h-24 object-contain"
                  />
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive status update script -->
  <script>
    const select = document.getElementById(
      "statusSelect",
    ) as HTMLSelectElement | null;
    const toast = document.getElementById("statusToast");

    if (select) {
      select.addEventListener("change", async () => {
        const ref = select.getAttribute("data-ref");
        const status = select.value;

        try {
          const res = await fetch("/api/admin/update-status", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ reference: ref, status }),
          });

          const data = await res.json();
          if (res.ok && data.success) {
            if (toast) {
              toast.textContent = `Status: ${status}!`;
              toast.classList.remove("hidden");
              setTimeout(() => {
                toast.classList.add("hidden");
              }, 2500);
            }
          } else {
            alert(data.message || "Failed to update status.");
          }
        } catch {
          alert("Network error while updating status.");
        }
      });
    }

    // Detail page Delete Confirmation Modal
    const detailDeleteBtn = document.getElementById("detailDeleteBtn");
    const detailDeleteModal = document.getElementById("detailDeleteModal");
    const detailCancelDeleteBtn = document.getElementById(
      "detailCancelDeleteBtn",
    );
    const detailConfirmDeleteBtn = document.getElementById(
      "detailConfirmDeleteBtn",
    ) as HTMLButtonElement | null;
    const detailConfirmDeleteBtnText = document.getElementById(
      "detailConfirmDeleteBtnText",
    );

    function openDetailDeleteModal() {
      if (detailDeleteModal) {
        detailDeleteModal.classList.remove("hidden");
        document.body.classList.add("overflow-hidden");
      }
    }

    function closeDetailDeleteModal() {
      if (detailDeleteModal) {
        detailDeleteModal.classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
      }
      if (detailConfirmDeleteBtn) detailConfirmDeleteBtn.disabled = false;
      if (detailConfirmDeleteBtnText)
        detailConfirmDeleteBtnText.textContent = "Confirm Delete";
    }

    detailDeleteBtn?.addEventListener("click", openDetailDeleteModal);
    detailCancelDeleteBtn?.addEventListener("click", closeDetailDeleteModal);
    document
      .getElementById("detailDeleteBackdrop")
      ?.addEventListener("click", closeDetailDeleteModal);

    detailConfirmDeleteBtn?.addEventListener("click", async () => {
      const targetId = detailDeleteBtn?.getAttribute("data-id");
      if (!targetId) return;

      if (detailConfirmDeleteBtn) detailConfirmDeleteBtn.disabled = true;
      if (detailConfirmDeleteBtnText)
        detailConfirmDeleteBtnText.textContent = "Deleting...";

      try {
        const res = await fetch(
          `/api/admin/applications/${encodeURIComponent(targetId)}`,
          {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
          },
        );

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.href = "/admin/dashboard";
        } else {
          alert(data.message || "Failed to delete application.");
          if (detailConfirmDeleteBtn) detailConfirmDeleteBtn.disabled = false;
          if (detailConfirmDeleteBtnText)
            detailConfirmDeleteBtnText.textContent = "Confirm Delete";
        }
      } catch (err) {
        console.error("Delete error:", err);
        alert("Network or server error while deleting application.");
        if (detailConfirmDeleteBtn) detailConfirmDeleteBtn.disabled = false;
        if (detailConfirmDeleteBtnText)
          detailConfirmDeleteBtnText.textContent = "Confirm Delete";
      }
    });

    window.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        detailDeleteModal &&
        !detailDeleteModal.classList.contains("hidden")
      ) {
        closeDetailDeleteModal();
      }
    });
  </script>
  <!-- Detail Page Delete Confirmation Modal -->
  <div
    id="detailDeleteModal"
    class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 overflow-y-auto"
    aria-labelledby="detailDeleteModalTitle"
    role="dialog"
    aria-modal="true"
  >
    <div
      id="detailDeleteBackdrop"
      class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm transition-opacity"
    ></div>
    <div class="relative bg-slate-900 border border-slate-800 rounded-3xl max-w-md w-full p-6 sm:p-7 shadow-2xl z-10 space-y-5">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-2xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 shrink-0">
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
            />
          </svg>
        </div>
        <div>
          <h3
            id="detailDeleteModalTitle"
            class="text-lg font-bold text-white tracking-tight"
          >
            Delete Application
          </h3>
          <p class="text-sm text-slate-300 mt-2 leading-relaxed">
            Are you sure you want to permanently delete application{" "}
            <span class="font-mono font-bold text-amber-400">
              {app.reference}
            </span>
            ?
          </p>
          <p class="text-xs text-slate-400 mt-2">
            This action cannot be undone. All related records, uploaded evidence
            files, and generated PDF dossiers will be permanently deleted from
            the database and storage.
          </p>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800/80">
        <button
          type="button"
          id="detailCancelDeleteBtn"
          class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold border border-slate-700 transition-colors"
        >
          Cancel
        </button>
        <button
          type="button"
          id="detailConfirmDeleteBtn"
          class="inline-flex items-center space-x-1.5 px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shadow-lg shadow-rose-900/30 transition-all hover:scale-[1.02] disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
            />
          </svg>
          <span id="detailConfirmDeleteBtnText">Confirm Delete</span>
        </button>
      </div>
    </div>
  </div>
</AdminLayout>
