---
// src/pages/admin/signup.astro — Secure Administrator Registration Portal
import Layout from '@/layouts/Layout.astro';
import { generateCsrfToken, verifySessionToken } from '@/lib/auth';

// Redirect if already authenticated
const sessionCookie = Astro.cookies.get('admin_session')?.value;
if (sessionCookie && verifySessionToken(sessionCookie)) {
  return Astro.redirect('/admin/dashboard');
}

const csrfToken = generateCsrfToken();
const title = "Register Administrator | Best Diversified Company Award";
---

<Layout title={title}>
  <div class="min-h-screen bg-slate-900 flex flex-col justify-center py-12 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Ambient illumination -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="sm:mx-auto sm:w-full sm:max-w-md relative z-10 px-4 sm:px-0">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-500 to-amber-700 shadow-xl shadow-amber-500/20 mb-4 border border-amber-400/30">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Admin Registration</h2>
        <p class="mt-2 text-sm text-slate-400">Create an authorized executive account</p>
      </div>

      <div class="mt-8 bg-slate-800/90 border border-slate-700/80 backdrop-blur-xl py-8 px-6 sm:px-10 shadow-2xl rounded-2xl">
        <!-- Error Alert -->
        <div id="errorAlert" class="hidden mb-6 rounded-lg bg-rose-500/10 border border-rose-500/30 p-4 text-sm text-rose-300 flex items-start space-x-3">
          <svg class="w-5 h-5 text-rose-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="errorMessage">Registration failed</span>
        </div>

        <!-- Success Alert -->
        <div id="successAlert" class="hidden mb-6 rounded-lg bg-emerald-500/10 border border-emerald-500/30 p-4 text-sm text-emerald-300 flex items-start space-x-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span id="successMessage">Admin registered successfully! Redirecting to sign in...</span>
        </div>

        <form id="signupForm" class="space-y-5">
          <input type="hidden" name="csrf_token" value={csrfToken} />

          <!-- Full Name -->
          <div>
            <label for="name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Full Name
            </label>
            <div class="mt-1.5 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="Dr. Samantha Wickramasinghe"
                class="block w-full pl-10 pr-4 py-2.5 bg-slate-900/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-sm transition-all"
              />
            </div>
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Administrator Email
            </label>
            <div class="mt-1.5 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                </svg>
              </div>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="evaluator@award.gov.lk"
                class="block w-full pl-10 pr-4 py-2.5 bg-slate-900/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-sm transition-all"
              />
            </div>
          </div>

          <!-- Password -->
          <div>
            <label for="password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Password (Min 8 Characters)
            </label>
            <div class="mt-1.5 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <input
                id="password"
                name="password"
                type="password"
                required
                minlength="8"
                placeholder="••••••••••••"
                class="block w-full pl-10 pr-4 py-2.5 bg-slate-900/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-sm transition-all"
              />
            </div>
          </div>

          <!-- Confirm Password -->
          <div>
            <label for="confirm_password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Confirm Password
            </label>
            <div class="mt-1.5 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <input
                id="confirm_password"
                name="confirm_password"
                type="password"
                required
                minlength="8"
                placeholder="••••••••••••"
                class="block w-full pl-10 pr-4 py-2.5 bg-slate-900/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-sm transition-all"
              />
            </div>
          </div>

          <!-- Secret Passcode -->
          <div class="pt-2">
            <div class="flex items-center justify-between">
              <label for="secret_key" class="block text-xs font-semibold text-amber-400 uppercase tracking-wider">
                Admin Secret Passcode
              </label>
              <span class="text-[11px] text-slate-400">Required for authorization</span>
            </div>
            <div class="mt-1.5 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                </svg>
              </div>
              <input
                id="secret_key"
                name="secret_key"
                type="password"
                required
                placeholder="Enter system registration secret"
                class="block w-full pl-10 pr-4 py-2.5 bg-slate-900/80 border border-amber-500/50 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-sm transition-all"
              />
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              id="submitBtn"
              class="w-full flex justify-center items-center py-3.5 px-4 border border-transparent rounded-xl shadow-lg text-sm font-bold text-slate-950 bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transition-all transform active:scale-[0.99]"
            >
              <span id="btnText">Create Administrator Account</span>
              <svg id="btnSpinner" class="hidden animate-spin -mr-1 ml-3 h-5 w-5 text-slate-950" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>

        <!-- Toggle link to Login -->
        <div class="mt-6 pt-6 border-t border-slate-700/60 text-center">
          <p class="text-sm text-slate-400">
            Already have an account?{' '}
            <a href="/admin/login" class="font-semibold text-amber-400 hover:text-amber-300 transition-colors">
              Sign In
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('signupForm') as HTMLFormElement | null;
    const errorAlert = document.getElementById('errorAlert');
    const errorMessage = document.getElementById('errorMessage');
    const successAlert = document.getElementById('successAlert');
    const successMessage = document.getElementById('successMessage');
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorAlert) errorAlert.classList.add('hidden');
        if (successAlert) successAlert.classList.add('hidden');

        const pwd = (document.getElementById('password') as HTMLInputElement)?.value;
        const confirmPwd = (document.getElementById('confirm_password') as HTMLInputElement)?.value;

        if (pwd !== confirmPwd) {
          if (errorAlert && errorMessage) {
            errorMessage.textContent = 'Passwords do not match.';
            errorAlert.classList.remove('hidden');
          }
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Creating Account...';
        if (btnSpinner) btnSpinner.classList.remove('hidden');

        const formData = new FormData(form);

        try {
          const res = await fetch('/api/admin/signup', {
            method: 'POST',
            body: formData,
          });

          const data = await res.json();

          if (res.ok && data.success) {
            if (successAlert && successMessage) {
              successMessage.textContent = data.message || 'Administrator registered successfully! Redirecting...';
              successAlert.classList.remove('hidden');
            }
            setTimeout(() => {
              window.location.href = data.redirect || '/admin/login?registered=1';
            }, 1500);
          } else {
            if (errorAlert && errorMessage) {
              errorMessage.textContent = data.message || 'Registration failed. Please check your details.';
              errorAlert.classList.remove('hidden');
            }
          }
        } catch {
          if (errorAlert && errorMessage) {
            errorMessage.textContent = 'Network or connection error. Please try again.';
            errorAlert.classList.remove('hidden');
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Create Administrator Account';
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      });
    }
  </script>
</Layout>
