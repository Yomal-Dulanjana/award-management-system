---
import Layout from "@/layouts/Layout.astro";
import { buildDownloadUrl } from "@/lib/security";
import { getBaseUrl } from "@/lib/url";

// Server-side reference resolution if available via query parameter
const refParam = Astro.url.searchParams.get("ref") ?? "";
const baseUrl = getBaseUrl(Astro.request);
const serverDownloadUrl = refParam ? buildDownloadUrl(refParam, baseUrl) : "";
---

<Layout title="Application Submitted - Best Diversified Company Award 2025/26">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-8 sm:p-12 shadow-2xl backdrop-blur-xl text-center space-y-8">
      <!-- Success Icon -->
      <div class="w-20 h-20 mx-auto rounded-3xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center shadow-lg shadow-emerald-500/10 animate-bounce-slow">
        <svg
          class="w-10 h-10"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M5 13l4 4L19 7"
          />
        </svg>
      </div>

      <!-- Main Headline -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">
          Submission Confirmed
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Application submitted successfully
        </h1>
        <p class="text-slate-400 text-sm max-w-lg mx-auto">
          Thank you. Your Best Diversified Company Award 2025/26 application has
          been received.
        </p>
      </div>

      <!-- Reference Code Box -->
      <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-6 max-w-md mx-auto space-y-2 shadow-inner">
        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">
          Official Reference Number
        </span>
        <div
          id="display-ref"
          class="text-2xl sm:text-3xl font-mono font-extrabold text-amber-400 tracking-wider"
        >
          {refParam || "BDC-2026-SUBMISSION"}
        </div>
        <p class="text-[11px] text-slate-500">
          Please keep this reference number for future correspondence.
        </p>
      </div>

      <!-- Status Chips Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left max-w-md mx-auto">
        <div class="flex items-center gap-3 p-3.5 rounded-xl bg-slate-800/40 border border-slate-800 text-xs text-slate-300">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
          <span>Application verified & stored securely</span>
        </div>
        <div
          id="email-chip"
          class="flex items-center gap-3 p-3.5 rounded-xl bg-slate-800/40 border border-slate-800 text-xs text-slate-300"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
          <span id="email-status-text">Confirmation email dispatched</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          id="download-pdf-btn"
          href={serverDownloadUrl || "#"}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-sm shadow-xl shadow-amber-500/25 hover:shadow-amber-500/40 transition-all"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          <span>Download Submitted Application PDF</span>
        </a>

        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-xl border border-slate-700 bg-slate-800/40 hover:bg-slate-800 text-slate-300 font-semibold text-sm transition-colors"
        >
          Return to Home
        </a>
      </div>

      <!-- Next Steps Callout -->
    </div>
  </div>
</Layout>

<script>
  function hydrateSuccess() {
    const ref = sessionStorage.getItem("submitted_reference");
    const downloadUrl = sessionStorage.getItem("submitted_download_url");
    const email = sessionStorage.getItem("submitted_email");
    const emailSent = sessionStorage.getItem("submitted_email_sent");

    if (ref) {
      const displayRef = document.getElementById("display-ref");
      if (displayRef) displayRef.textContent = ref;
    }

    if (downloadUrl) {
      const downloadBtn = document.getElementById(
        "download-pdf-btn",
      ) as HTMLAnchorElement | null;
      if (downloadBtn) downloadBtn.href = downloadUrl;
    }

    if (email && emailSent === "1") {
      const emailStatusText = document.getElementById("email-status-text");
      if (emailStatusText) {
        emailStatusText.textContent = `Confirmation sent to ${email}`;
      }
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", hydrateSuccess);
  } else {
    hydrateSuccess();
  }
</script>
