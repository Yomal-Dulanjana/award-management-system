---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Best Diversified Company Award 2025/26 - Official Portal">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
    <!-- Background Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-amber-500/10 blur-[140px] pointer-events-none rounded-full"></div>
    <div class="absolute top-10 right-10 w-[400px] h-[400px] bg-blue-600/10 blur-[120px] pointer-events-none rounded-full"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Copy Column -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold tracking-wide uppercase">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            Online Application • Financial Year 2025/26
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
            Best Diversified <br />
            <span class="bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 bg-clip-text text-transparent">
              Company Award
            </span>
          </h1>

          <div class="text-lg sm:text-xl font-bold text-white">Financial Year 2025/26</div>

          <p class="text-sm sm:text-base lg:text-lg text-slate-300 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
            Before registering, please review the mandatory eligibility criteria
            below. A company must meet both diversification conditions to be
            eligible to apply.
          </p>

          <!-- Highlight badges -->
          <div class="grid grid-cols-3 gap-2 sm:gap-3 pt-2 max-w-lg mx-auto lg:mx-0">
            <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-2.5 sm:p-3 text-center">
              <div class="text-lg sm:text-xl font-bold text-amber-400">6</div>
              <div class="text-[10px] sm:text-[11px] font-medium text-slate-400 leading-tight">
                Application Steps
              </div>
            </div>
            <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-2.5 sm:p-3 text-center">
              <div class="text-lg sm:text-xl font-bold text-amber-400">2</div>
              <div class="text-[10px] sm:text-[11px] font-medium text-slate-400 leading-tight">
                Mandatory Conditions
              </div>
            </div>
            <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-2.5 sm:p-3 text-center">
              <div class="text-lg sm:text-xl font-bold text-emerald-400">Secure</div>
              <div class="text-[10px] sm:text-[11px] font-medium text-slate-400 leading-tight">
                Online Submission
              </div>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a
              href="/apply"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-base shadow-xl shadow-amber-500/25 hover:shadow-amber-500/40 hover:-translate-y-0.5 transition-all duration-200 min-h-[48px]"
            >
              <span>Start Application</span>
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </a>
          </div>
        </div>

        <!-- Trophy Column -->
        <div class="lg:col-span-5 flex justify-center relative">
          <div class="relative w-56 sm:w-72 lg:w-96 mx-auto">
            <!-- Glow circle behind trophy -->
            <div class="absolute inset-0 bg-gradient-to-b from-amber-500/20 to-blue-600/10 rounded-full blur-2xl transform scale-90"></div>

            <picture>
              <source
                srcset="/assets/images/award-trophy.webp"
                type="image/webp"
              />
              <img
                src="/assets/images/award-trophy.png"
                alt="Best Diversified Company Award Trophy"
                class="relative z-10 w-full h-auto drop-shadow-[0_20px_40px_rgba(0,0,0,0.6)] animate-fade-in hover:scale-105 transition-transform duration-500 max-h-[420px] sm:max-h-[500px] object-contain"
                width="900"
                height="1350"
                fetchpriority="high"
              />
            </picture>

            <!-- Base shadow -->
            <div class="h-6 w-3/4 mx-auto bg-black/60 blur-lg rounded-full -mt-4"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Focused Evaluation Criteria: Nature of Diversification (Core Qualification) -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-20 relative z-20">
    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl sm:rounded-3xl p-4 sm:p-8 lg:p-10 shadow-2xl backdrop-blur-md">
      <!-- Top Pill Badge -->
      <div class="flex justify-center mb-3">
        <span class="inline-flex items-center bg-blue-950/60 text-blue-400 border border-blue-800/60 rounded-full px-3 sm:px-4 py-1 text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-center">
          FOCUSED EVALUATION CRITERIA
        </span>
      </div>

      <!-- Heading & Subtitle -->
      <h2 class="text-xl sm:text-3xl lg:text-4xl font-extrabold text-center tracking-tight">
        <span class="text-white">Nature of Diversification</span>{" "}
        <span class="text-blue-400">(Core Qualification)</span>
      </h2>
      <!-- <p class="text-slate-400 text-sm mt-1 text-center">
        Mandatory condition for registration and award evaluation
      </p> -->

      <!-- Mandatory Condition Banner (Full Width) -->
      <div class="bg-blue-950/40 border border-blue-900/60 rounded-2xl p-4 sm:p-5 flex items-start gap-4 mt-6">
        <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-lg shadow-blue-600/30 font-bold text-lg select-none">
          !
        </div>
        <div class="space-y-1">
          <h3 class="text-white font-bold text-sm sm:text-base">
            Mandatory Condition
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            The company must have{" "}
            <strong class="text-white font-semibold">
              introduced new products/services and entered new markets
            </strong>{" "}
            during the evaluation period.
          </p>
        </div>
      </div>

      <!-- Two-Column Comparison Grid (What qualifies vs. Not Eligible) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-6">
        <!-- Left Column: What qualifies -->
        <div class="bg-emerald-950/20 border border-emerald-800/40 rounded-2xl p-5 sm:p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <div class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              </div>
              <h3 class="text-emerald-400 font-bold text-base">
                What Qualifies
              </h3>
            </div>

            <ul class="space-y-3 text-xs sm:text-sm text-slate-300">
              <li class="flex items-start gap-2.5">
                <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </div>
                <span>
                  The product or service{" "}
                  <strong class="text-white font-semibold">
                    did not previously exist
                  </strong>{" "}
                  within the company.
                </span>
              </li>
              <li class="flex items-start gap-2.5">
                <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </div>
                <span>
                  The market or customer segment had{" "}
                  <strong class="text-white font-semibold">
                    not previously been served.
                  </strong>
                </span>
              </li>
            </ul>
          </div>

          <!-- Highlighted Bottom Box Inside Left Card -->
          <div class="bg-emerald-900/30 border border-emerald-700/40 rounded-xl p-3 text-emerald-300 font-semibold text-xs flex items-center gap-2 mt-4">
            <svg
              class="w-4 h-4 text-emerald-400 shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"
              />
            </svg>
            <span>Both conditions must be met to qualify.</span>
          </div>
        </div>

        <!-- Right Column: Not Eligible -->
        <div class="bg-rose-950/20 border border-rose-900/40 rounded-2xl p-5 sm:p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <div class="w-6 h-6 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0">
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 18L18 6M6 6l12 12"
                  />
                </svg>
              </div>
              <h3 class="text-rose-400 font-bold text-base">Not Eligible</h3>
            </div>

            <div class="space-y-3.5">
              <div class="flex items-start gap-2.5">
                <div class="w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12"
                    />
                  </svg>
                </div>
                <div>
                  <div class="text-rose-200 font-medium text-sm">
                    Existing Product + New Market
                  </div>
                  <div class="text-rose-400/80 text-xs mt-0.5">
                    Market Development (Not Eligible)
                  </div>
                </div>
              </div>

              <div class="flex items-start gap-2.5 mt-3">
                <div class="w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12"
                    />
                  </svg>
                </div>
                <div>
                  <div class="text-rose-200 font-medium text-sm">
                    New Product + Existing Market
                  </div>
                  <div class="text-rose-400/80 text-xs mt-0.5">
                    Product Development (Not Eligible)
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Action Bar -->
      <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4 mt-6">
        <div class="text-center sm:text-left">
          <div class="text-white font-semibold text-base">
            Do you meet both mandatory conditions?
          </div>
          <div class="text-slate-400 text-xs mt-0.5">
            If yes, continue to the registration and application form.
          </div>
        </div>

        <a
          href="/apply"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm shadow-lg shadow-blue-900/30 hover:shadow-blue-600/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-150 shrink-0 min-h-[44px]"
        >
          <span>Register / Start Application</span>
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
