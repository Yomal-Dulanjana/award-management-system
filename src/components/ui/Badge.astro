---
// Reusable UI status/pill badge component
interface Props {
  variant?: "default" | "success" | "warning" | "danger" | "info" | "gold";
  size?: "sm" | "md";
  class?: string;
}

const { variant = "default", size = "sm", class: className = "" } = Astro.props;

const variantStyles = {
  default: "bg-slate-800 text-slate-300 border-slate-700",
  success: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  warning: "bg-amber-500/10 text-amber-400 border-amber-500/20",
  danger: "bg-rose-500/10 text-rose-400 border-rose-500/20",
  info: "bg-blue-500/10 text-blue-400 border-blue-500/20",
  gold: "bg-gradient-to-r from-amber-500/20 to-amber-600/20 text-amber-300 border-amber-500/40",
};

const sizeStyles = {
  sm: "px-2.5 py-0.5 text-xs font-semibold",
  md: "px-3.5 py-1 text-sm font-semibold",
};
---

<span
  class={`inline-flex items-center rounded-full border transition-colors ${variantStyles[variant]} ${sizeStyles[size]} ${className}`}
>
  <slot />
</span>
