---
interface Props {
  id?: string;
  name?: string;
}

const { id = "signature_data", name = "signature_data" } = Astro.props;
---

<div class="space-y-3" id="signature-component">
  <div class="relative bg-white rounded-xl border-2 border-dashed border-slate-300 hover:border-amber-400 focus-within:border-amber-500 transition-colors shadow-inner overflow-hidden">
    <canvas
      id="sig-canvas"
      class="w-full h-44 touch-none cursor-crosshair bg-white block"
      tabindex="0"
      aria-label="Draw your digital signature here"
    ></canvas>

    <!-- Watermark / Placeholder helper -->
    <div
      id="sig-placeholder"
      class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-slate-400 text-sm select-none"
    >
      <svg class="w-8 h-8 mb-1.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
      </svg>
      <span class="font-medium text-slate-500">Sign here using mouse, touch, or stylus</span>
      <span class="text-[11px] text-slate-400 mt-0.5">Press and drag inside this box to create your signature</span>
    </div>

    <!-- Active Indicator -->
    <div class="absolute bottom-2 left-3 text-[10px] font-mono font-semibold tracking-wider text-slate-400 uppercase select-none pointer-events-none">
      256-BIT SECURE SIGNATURE CAPTURE
    </div>
  </div>

  <div class="flex items-center justify-between">
    <span class="text-xs text-slate-400">
      Draw signature above. High-resolution vector capture for official dossier.
    </span>
    <button
      type="button"
      id="sig-clear-btn"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 border border-rose-900/60 rounded-lg transition-colors cursor-pointer"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
      <span>Clear Signature</span>
    </button>
  </div>

  <input type="hidden" id={id} name={name} value="" />
</div>

<script>
  function initSignaturePad() {
    const canvas = document.getElementById('sig-canvas') as HTMLCanvasElement | null;
    const input = document.getElementById('signature_data') as HTMLInputElement | null;
    const clearBtn = document.getElementById('sig-clear-btn');
    const placeholder = document.getElementById('sig-placeholder');

    if (!canvas || !input) return;

    let ctx = canvas.getContext('2d');
    if (!ctx) return;

    let isDrawing = false;
    let hasDrawn = false;
    let strokePoints = 0;
    let lastX = 0;
    let lastY = 0;

    function resizeCanvas(force = false) {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      // If canvas is currently in a hidden container (display: none), rect.width is 0. Do NOT resize to 0!
      if (rect.width < 10) return;

      const dpr = Math.max(window.devicePixelRatio || 1, 1);
      const cssWidth = Math.floor(rect.width);
      const cssHeight = 176; // fixed h-44 in CSS

      const targetWidth = Math.floor(cssWidth * dpr);
      const targetHeight = Math.floor(cssHeight * dpr);

      // If dimensions haven't changed and not forced, keep buffer
      if (!force && canvas.width === targetWidth && canvas.height === targetHeight) {
        return;
      }

      // Preserve existing signature image if present
      const savedData = hasDrawn ? canvas.toDataURL('image/png') : (input?.value || null);

      canvas.width = targetWidth;
      canvas.height = targetHeight;
      canvas.style.width = `${cssWidth}px`;
      canvas.style.height = `${cssHeight}px`;

      ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineWidth = 2.4;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#0b2043'; // Executive navy stroke

      if (savedData && (hasDrawn || input?.value)) {
        const img = new Image();
        img.onload = () => {
          if (!ctx) return;
          ctx.drawImage(img, 0, 0, cssWidth, cssHeight);
          hasDrawn = true;
          if (placeholder) placeholder.style.display = 'none';
        };
        img.src = savedData;
      } else {
        if (placeholder) placeholder.style.display = 'flex';
      }
    }

    // Expose resize trigger globally so parent step manager can call it when Step 6 becomes visible
    (window as any).resizeSignatureCanvas = () => {
      requestAnimationFrame(() => {
        resizeCanvas(false);
      });
    };

    // Also listen to custom event
    window.addEventListener('resize-signature-canvas', () => {
      resizeCanvas(false);
    });

    window.addEventListener('resize', () => {
      resizeCanvas(false);
    });

    function getCoords(e: MouseEvent | TouchEvent) {
      if (!canvas) return { x: 0, y: 0 };
      const rect = canvas.getBoundingClientRect();
      let clientX = 0;
      let clientY = 0;

      if ('touches' in e && e.touches.length > 0) {
        const touch = e.touches[0]!;
        clientX = touch.clientX;
        clientY = touch.clientY;
      } else if ('clientX' in e) {
        const me = e as MouseEvent;
        clientX = me.clientX;
        clientY = me.clientY;
      }

      return {
        x: clientX - rect.left,
        y: clientY - rect.top,
      };
    }

    function startDrawing(e: MouseEvent | TouchEvent) {
      // Ensure canvas is properly sized before drawing
      resizeCanvas(false);
      if (!ctx) return;

      isDrawing = true;
      hasDrawn = true;
      strokePoints++;
      if (placeholder) placeholder.style.display = 'none';

      const { x, y } = getCoords(e);
      lastX = x;
      lastY = y;

      ctx.beginPath();
      ctx.arc(x, y, 1.2, 0, Math.PI * 2);
      ctx.fill();

      if ('touches' in e) e.preventDefault();
    }

    function draw(e: MouseEvent | TouchEvent) {
      if (!isDrawing || !ctx) return;
      const { x, y } = getCoords(e);

      ctx.beginPath();
      ctx.moveTo(lastX, lastY);
      ctx.lineTo(x, y);
      ctx.stroke();

      lastX = x;
      lastY = y;
      strokePoints++;
      if ('touches' in e) e.preventDefault();
    }

    function stopDrawing() {
      if (!isDrawing || !canvas || !input) return;
      isDrawing = false;
      const dataUrl = canvas.toDataURL('image/png');
      input.value = dataUrl;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function clear() {
      if (!canvas || !ctx || !input) return;
      const rect = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, rect.width, rect.height);
      input.value = '';
      hasDrawn = false;
      strokePoints = 0;
      if (placeholder) placeholder.style.display = 'flex';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }

    // Expose empty check
    (window as any).isSignatureBlank = () => {
      if (!input?.value || input.value.length < 100) return true;
      if (!hasDrawn) return true;
      if (strokePoints > 0 && strokePoints < 5) return true;
      return false;
    };

    // Pointer / Mouse events
    canvas.addEventListener('mousedown', startDrawing);
    canvas.addEventListener('mousemove', draw);
    window.addEventListener('mouseup', stopDrawing);

    // Touch events
    canvas.addEventListener('touchstart', startDrawing, { passive: false });
    canvas.addEventListener('touchmove', draw, { passive: false });
    window.addEventListener('touchend', stopDrawing);

    // Prevent default touch scrolling inside canvas
    canvas.addEventListener('touchcancel', stopDrawing);

    // Clear button
    clearBtn?.addEventListener('click', clear);

    // Initial check (if already visible)
    resizeCanvas(false);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSignaturePad);
  } else {
    initSignaturePad();
  }
</script>
