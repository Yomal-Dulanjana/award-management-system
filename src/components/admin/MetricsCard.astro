---
// Reusable admin metric summary card
interface Props {
  label: string;
  count: number;
  color?: "slate" | "amber" | "blue" | "emerald" | "rose";
}

const { label, count, color = "slate" } = Astro.props;

const colorMap = {
  slate: {
    bg: "bg-slate-900/60 border-slate-800",
    text: "text-white",
    indicator: "bg-slate-500",
  },
  amber: {
    bg: "bg-amber-950/20 border-amber-900/40",
    text: "text-amber-400",
    indicator: "bg-amber-500",
  },
  blue: {
    bg: "bg-blue-950/20 border-blue-900/40",
    text: "text-blue-400",
    indicator: "bg-blue-500",
  },
  emerald: {
    bg: "bg-emerald-950/20 border-emerald-900/40",
    text: "text-emerald-400",
    indicator: "bg-emerald-500",
  },
  rose: {
    bg: "bg-rose-950/20 border-rose-900/40",
    text: "text-rose-400",
    indicator: "bg-rose-500",
  },
};

const c = colorMap[color];
---

<div class={`rounded-2xl border p-4 sm:p-5 flex items-center justify-between shadow-lg ${c.bg}`}>
  <div>
    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">
      {label}
    </span>
    <span class={`text-2xl sm:text-3xl font-extrabold tracking-tight mt-1 block ${c.text}`}>
      {count}
    </span>
  </div>
  <div class={`w-3 h-3 rounded-full ${c.indicator}`}></div>
</div>
