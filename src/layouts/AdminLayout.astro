---
// src/layouts/AdminLayout.astro — Master layout for authenticated Admin Portal
interface Props {
  title: string;
  activeNav?: "dashboard" | "applications" | "settings";
}

const { title, activeNav = "dashboard" } = Astro.props;
const admin = Astro.locals.admin ?? {
  name: "Administrator",
  email: "admin@award.gov.lk",
};
---

<!doctype html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body {
        font-family: "Plus Jakarta Sans", sans-serif;
      }
      .font-mono {
        font-family: "JetBrains Mono", monospace;
      }
    </style>
  </head>
  <body class="h-full flex flex-col antialiased selection:bg-amber-500 selection:text-slate-950">
    <!-- Top Executive Navigation Bar -->
    <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-7xl 2xl:max-w-[1600px] mx-auto px-4 sm:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Brand Badge -->
          <div class="flex items-center space-x-3">
            <a
              href="/admin/dashboard"
              class="flex items-center space-x-3 group"
            >
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-lg shadow-amber-500/20 border border-amber-400/40 group-hover:scale-105 transition-transform">
                <svg
                  class="w-5 h-5 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                  />
                </svg>
              </div>
              <div>
                <span class="text-sm font-bold tracking-tight text-white block">
                  AWARD EVALUATION
                </span>
                <span class="text-[10px] tracking-widest text-amber-400 uppercase font-bold block">
                  Executive Portal
                </span>
              </div>
            </a>

            <!-- Nav Links -->
            <nav class="hidden md:flex ml-8 space-x-2">
              <a
                href="/admin/dashboard"
                class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${
                  activeNav === "dashboard"
                    ? "bg-amber-500/10 text-amber-400 border border-amber-500/20"
                    : "text-slate-400 hover:text-white hover:bg-slate-800"
                }`}
              >
                Applications Overview
              </a>
              <a
                href="/admin/settings"
                class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center space-x-1 ${
                  activeNav === "settings"
                    ? "bg-amber-500/10 text-amber-400 border border-amber-500/20"
                    : "text-slate-400 hover:text-white hover:bg-slate-800"
                }`}
                title="Configure Admin Notification Settings"
              >
                <span>Email Settings</span>
              </a>
              <a
                href="/"
                target="_blank"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition-colors flex items-center space-x-1"
              >
                <span>Live Public Form</span>
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              </a>
            </nav>
          </div>

          <!-- User Badge & Logout -->
          <div class="flex items-center space-x-4">
            <div class="hidden sm:flex flex-col text-right">
              <span class="text-xs font-semibold text-white">{admin.name}</span>
              <span class="text-[11px] text-slate-400 font-mono">
                {admin.email}
              </span>
            </div>

            <div class="h-6 w-px bg-slate-800 hidden sm:block"></div>

            <form action="/api/admin/logout" method="POST">
              <button
                type="submit"
                class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/10 text-slate-300 hover:text-rose-400 border border-slate-700/80 hover:border-rose-500/30 text-xs font-medium transition-all duration-150"
                title="Sign out of portal"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                  />
                </svg>
                <span class="hidden sm:inline">Logout</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 py-6 sm:py-8 px-4 sm:px-8 max-w-7xl 2xl:max-w-[1600px] mx-auto w-full">
      <slot />
    </main>

    <!-- Sub-footer -->
    <footer class="bg-slate-900/60 border-t border-slate-800/80 py-4 mt-auto">
      <div class="max-w-7xl 2xl:max-w-[1600px] mx-auto px-4 sm:px-8 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400">
        <p>
          © 2026 Best Diversified Company Award Committee. All Rights Reserved.
        </p>
        <p class="mt-2 sm:mt-0 font-mono text-[11px] text-slate-400">
          Secure Admin Portal v2.0
        </p>
      </div>
    </footer>
  </body>
</html>
